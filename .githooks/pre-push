#!/bin/sh
# Hands a push the Git LFS files it must send first (tools/Reference/References).
# git-lfs writes this hook itself; `git lfs install --manual` prints it for the hooks folder of this repository.
command -v git-lfs >/dev/null 2>&1 || {
    printf >&2 '\n%s\n\n' "This repository keeps the Cycles reference pictures with Git LFS, and 'git-lfs' is not on your path: install it and run 'git lfs install' one time."
    exit 2
}
git lfs pre-push "$@"

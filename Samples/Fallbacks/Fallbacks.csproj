<Project>

  <!-- The Fallbacks sample as a project: its .magic file and assets to browse, and Scripts\ compiled into a gem
       in the sample's own Build\ tree (see Samples\Directory.Build.props), where the host finds it. Build it
       with "dotnet build Samples\Fallbacks"; rebuild while the sample runs to hot reload the scripts. -->
  <PropertyGroup>
    <IsMagicGem>true</IsMagicGem>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Script assets: classes the chunks attach to entities by the file's asset id. A gem under the sample is a
         project of its own. -->
    <Compile Include="Assets\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against the host, never copy it: the scripts share the host's loaded Magic.dll. -->
    <ProjectReference Include="$(MagicRoot)Magic\Magic.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The samples' shared gem (the CameraController and OrbitSystem scripts): its dll is copied beside this one, so the host loads it
         with the sample. -->
    <ProjectReference Include="..\SampleShared\SampleShared.csproj" />
  </ItemGroup>

  <!-- What the host says of the dll when it loads it. -->
  <PropertyGroup>
    <Description>The Fallbacks sample; it has no scripts of its own yet.</Description>
    <Authors>Magic</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

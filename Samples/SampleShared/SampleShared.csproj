<Project>

  <!-- The gem every sample shares: each sample's csproj references it, so its dll is copied into that sample's own
       Build\ tree (see Samples\Directory.Build.props), where the host finds it as one of the project's gems. It is
       not a project itself and nothing loads it from here. -->
  <PropertyGroup>
    <IsMagicGem>true</IsMagicGem>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the host, never copy it: the gem shares the host's loaded Magic.dll. -->
    <ProjectReference Include="$(MagicRoot)Magic\Magic.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The gem, as the host sees it before constructing it (see Directory.Build.props). -->
  <PropertyGroup>
    <GemStatic>false</GemStatic>
    <Description>What the samples share: the CameraController and OrbitSystem scripts.</Description>
    <Authors>Magic</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

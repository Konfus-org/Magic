<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- The samples' scripts (Assets\**\*.cs) compile into a dll that belongs to the Samples project, not the engine: it
       builds into this folder's own Build\ tree, laid out like the engine's (Build\net10.0\<Configuration>\bin\ and
       obj\), where the host finds the dll by searching the project folder. That search skips obj\, so the
       intermediate copy is never loaded. -->
  <PropertyGroup Condition="'$(IsMagicGem)' == 'true'">
    <OutputPath>$(MSBuildProjectDirectory)\Build\$(TargetFramework)\$(Configuration)\bin\</OutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\Build\$(TargetFramework)\$(Configuration)\obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
  </PropertyGroup>

  <!-- What the project writes at runtime, and what it builds, is not part of it; the .magic file and Assets\ are. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Build\**;Cache\**;Screenshots\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>

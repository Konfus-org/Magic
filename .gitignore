# Build output (centralized via Directory.Build.props)
Build/

# Per-project build output (kept as a fallback in case a project ever
# opts out of Directory.Build.props)
[Bb]in/
[Oo]bj/

# Import and shader caches (Project.Cache); rebuilt on demand
Library/
Cache/

# Written at runtime next to the executable (Project.Logs, Project.Screenshots, Project.Cache); kept out in case an
# older build or a tool wrote them under a project root
logs/
Logs/
screenshots/
Screenshots/
cache/
Cache/

# Crash reports (Log writes them into Logs/; this catches strays)
*.crash

# Dot folders are tools' own state (.vs, .vscode, .idea, .claude, .cr, ...): none is source.
# Dot files (.gitignore, .editorconfig, .gitattributes) are not folders, so they stay tracked.
.*/
!.github/
!.template.config/

# IDE
*.user
*.suo

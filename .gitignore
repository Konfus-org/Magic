# Build output (centralized via Directory.Build.props)
Build/

# Per-project build output (kept as a fallback in case a project ever
# opts out of Directory.Build.props)
[Bb]in/
[Oo]bj/

# Import and shader caches (Project.Cache); rebuilt on demand
Library/
Cache/

# Written at runtime next to the executable (Project.Logs, Project.Screenshots, Project.Cache); kept out in case an
# older build or a tool wrote them under a project root
logs/
Logs/
screenshots/
Screenshots/
cache/
Cache/

# Crash reports (Log writes them into Logs/; this catches strays)
*.crash

# Dot folders are tools' own state (.vs, .vscode, .idea, .cr, ...): none is source.
# Dot files (.gitignore, .editorconfig, .gitattributes) are not folders, so they stay tracked.
# Source after all: the agent setup in .claude (settings and their hooks, subagents, skills and the status line, but
# not a machine's local settings or worktrees), the git hooks that write and check each commit's subject (.githooks),
# and the dotnet tools the scripts run (.config/dotnet-tools.json).
.*/
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/agents/
!.claude/skills/
!.claude/statusline.ps1
!.config/
!.github/
!.githooks/
!.template.config/

# IDE
*.user
*.suo
# Launch profiles Visual Studio writes into a runnable project. Core's is tracked: its F5 opens the sample.
**/Properties/launchSettings.json

{
    "kind": "compute",
    "shader": {
        "id": 10061
    },
    "creates": [
        {
            "name": "ShadowSlots",
            "kind": "buffer",
            "bytes": 768,
            "zero": true
        },
        {
            "name": "ShadowCullArgs",
            "kind": "buffer",
            "bytes": 16,
            "usage": "indirect",
            "zero": true
        }
    ],
    "reads": [
        {
            "name": "Counts"
        },
        {
            "name": "ShadowCandidates"
        }
    ],
    "writes": [
        {
            "name": "Lights"
        },
        {
            "name": "ShadowViews"
        },
        {
            "name": "ShadowHeader"
        },
        {
            "name": "ShadowSlots"
        },
        {
            "name": "ShadowRefreshed"
        },
        {
            "name": "ShadowCullArgs"
        }
    ],
    "dispatch": {
        "groups": [
            1
        ]
    },
    "params": {
        "maxLocalLights": {
            "x": 8
        },
        "facesPerFrame": {
            "x": 8
        },
        "visibleSlots": {
            "x": 24
        }
    },
    "needs": "$shadowCasters",
    "tuning": {
        "maxLocalLights": {
            "label": "Shadowed local lights",
            "description": "How many point and spot lights cast shadows at once, the most important first.",
            "min": 0,
            "max": 32
        },
        "facesPerFrame": {
            "label": "Faces redrawn per frame",
            "description": "Local light shadow faces redrawn each frame, the oldest first; a new light draws all of its faces at once.",
            "min": 1,
            "max": 24
        },
        "visibleSlots": {
            "label": "Draw slots",
            "description": "Shadow views drawn in one frame. Must match what the pass creates in its file: change both there.",
            "fixed": true
        }
    }
}

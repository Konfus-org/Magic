<Project>

  <!-- Must come before the SDK props import: the Directory.Build.props of the engine repo, or of a Magic project,
       switches this project to gem output settings when IsMagicGem is true. -->
  <PropertyGroup>
    <IsMagicGem>true</IsMagicGem>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Spans over native component columns need pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The assembly is FlecsEcs, not Flecs: the native library is flecs.dll and the two would overwrite each
         other in bin\Gems. The namespace is FlecsEcsGem, not Flecs: inside a namespace named Flecs,
         "Flecs.NET.Core" would bind to the gem's own namespace instead of the library. -->
    <RootNamespace>FlecsEcsGem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Debug package asserts on API misuse (wrong thread, dead entity, ...); Release skips the checks.
         Both pull the native flecs library for the build's runtime in transitively. Every build takes Release:
         the Debug native library re-matches its cached queries so slowly after chunks spawn that a Debug engine
         build hitched 40 ms a frame while streaming. Build with -p:FlecsDebug=true to get the checks back. -->
    <PackageReference Include="Flecs.NET.Debug" Version="4.0.3" Condition="'$(FlecsDebug)' == 'true'" />
    <PackageReference Include="Flecs.NET.Release" Version="4.0.3" Condition="'$(FlecsDebug)' != 'true'" />
  </ItemGroup>

  <!-- Inside the engine repo the gem compiles against Core as a project reference. Inside a Magic project
       (MagicProjectRoot is set by the project's Directory.Build.props) that file references the engine's built
       Magic.dll instead, so nothing is added here. Either way Magic.dll is never copied next to the gem: the
       gem's load context shares the host's already-loaded copy, and a second copy would be a different
       assembly identity whose IGem the host would not recognise. -->
  <ItemGroup Condition="'$(MagicProjectRoot)' == ''">
    <ProjectReference Include="$(MagicRoot)Magic\Core\Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The gem, as the engine sees it before constructing it. GemStatic true: loaded once, never hot reloaded. -->
  <PropertyGroup>
    <GemStatic>true</GemStatic>
    <Description>Entity component system built on flecs.</Description>
    <Authors>Konfus</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

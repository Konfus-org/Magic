<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The project is named for its folder; what it builds is the engine, Magic.exe and Magic.dll, which every gem
         references by that name. -->
    <AssemblyName>Magic</AssemblyName>
    <RootNamespace>Magic</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gems compile against this too (it flows through their ProjectReference to Core),
         but must never load their own copy at runtime: see Gems.GemLoadContext. -->
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>


  <!-- The engine's own root, the project a run without a project argument opens (see Program.cs): the repo in Debug and
       Optimize, stamped as MagicRoot; in a shipped build the folder next to the exe. -->
  <ItemGroup Condition="'$(ShipResources)' != 'true'">
    <AssemblyMetadata Include="MagicRoot" Value="$(MagicRoot)" />
  </ItemGroup>

  <!-- The gems the runtime ships with. Building Magic builds them too, so bin\Gems\ is
       always populated after "dotnet build Magic\Core\Core.csproj". They cannot be plain
       ProjectReferences: each gem already references Core.csproj. -->
  <ItemGroup>
    <!-- EntityHierarchy first: DeferredRenderer and ChunkStreaming reference it, and are built without building their
         references. -->
    <DefaultGem Include="$(MagicRoot)Magic\Gems\World\EntityHierarchy\EntityHierarchy.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\World\Scripting\Scripting.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\SdlPlatform\SdlPlatform.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Debug\ZLoggerLogging\ZLoggerLogging.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\World\FlecsEcs\FlecsEcs.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Assets\SdlImageLoader\SdlImageLoader.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Assets\SdlFontLoader\SdlFontLoader.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Rendering\SdlShaderCompiler\SdlShaderCompiler.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Assets\AssimpModelLoader\AssimpModelLoader.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Rendering\SdlGpuRenderer\SdlGpuRenderer.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\CSharpScripting\CSharpScripting.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Debug\ConsoleCheats\ConsoleCheats.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Debug\ImGuiDebugUI\ImGuiDebugUI.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\LODs\ModelLodGenerator\ModelLodGenerator.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\LODs\ChunkLodGenerator\ChunkLodGenerator.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\World\ChunkStreaming\ChunkStreaming.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Rendering\DeferredRenderer\DeferredRenderer.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Debug\DebugTools\DebugTools.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\Debug\Screenshots\Screenshots.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\SettingsPresets\SettingsPresets.csproj" />
    <DefaultGem Include="$(MagicRoot)Magic\Gems\World\LoadingScreen\LoadingScreen.csproj" />
  </ItemGroup>

  <!-- "dotnet build" only restores the entry project and its ProjectReferences, so the gems
       have to be restored here or their Build below fails for a missing project.assets.json. -->
  <Target Name="RestoreDefaultGems" AfterTargets="Restore">
    <MSBuild Projects="@(DefaultGem)" Targets="Restore" Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- BuildProjectReferences=false: Magic.dll was just built by this very project, so the gems
       only read its output path instead of asking for a second build of it (which would also be
       a circular build request). Configuration is passed explicitly so a gem built from here
       always lands in the same Build\...\$(Configuration)\ tree as the host. Not when a solution is built from the
       command line: it builds every gem itself, and with other global properties than these, so both builds of a
       gem would run at once and fight over its dll. -->
  <Target Name="BuildDefaultGems" AfterTargets="Build" Condition="'$(BuildingSolutionFile)' != 'true'">
    <MSBuild Projects="@(DefaultGem)" Targets="Build" Properties="Configuration=$(Configuration);BuildProjectReferences=false" />
  </Target>

  <!-- Shipped, every part's Resources are one bundle beside the exe, bin\Resources\: made from scratch on every build, so
       nothing moved or deleted stays behind. The rigid layout (CODESTANDARDS.md, Resources) keeps two parts from having
       a file at the same path. -->
  <Target Name="BundleResources" AfterTargets="Build" Condition="'$(ShipResources)' == 'true'">
    <ItemGroup>
      <BundledResource Include="$(MSBuildProjectDirectory)\Resources\**" />
      <BundledResource Include="%(DefaultGem.RootDir)%(DefaultGem.Directory)Resources\**" />
    </ItemGroup>
    <RemoveDir Directories="$(MagicBuildDir)bin\Resources" />
    <Copy SourceFiles="@(BundledResource)" DestinationFiles="@(BundledResource->'$(MagicBuildDir)bin\Resources\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CleanDefaultGems" AfterTargets="Clean">
    <MSBuild Projects="@(DefaultGem)" Targets="Clean" Properties="Configuration=$(Configuration);BuildProjectReferences=false" />
  </Target>

</Project>

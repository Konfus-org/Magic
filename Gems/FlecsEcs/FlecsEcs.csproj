<Project>

  <!-- Must come before the SDK props import: Directory.Build.props (imported by the SDK)
       switches this project to gem output settings when IsMagicGem is true. -->
  <PropertyGroup>
    <IsMagicGem>true</IsMagicGem>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Spans over native component columns need pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The assembly is FlecsEcs, not Flecs: the native library is flecs.dll and the two would overwrite each
         other in bin\Gems. The namespace is FlecsGem, not Flecs: inside a namespace named Flecs,
         "Flecs.NET.Core" would bind to the gem's own namespace instead of the library. -->
    <RootNamespace>FlecsGem</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Debug package asserts on API misuse (wrong thread, dead entity, ...); Release skips the checks.
         Both pull the native flecs.dll for win-x64 in transitively. -->
    <PackageReference Include="Flecs.NET.Debug" Version="4.0.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Flecs.NET.Release" Version="4.0.3" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false + ExcludeAssets=runtime: compile against the host, but never copy Magic.dll
         (or its dependencies) next to this gem. The gem's load context shares the host's
         already-loaded copy (see Gems.LoadContext); a second copy would be a different
         assembly identity and the host would not recognise the gem's [Gem] attribute. -->
    <ProjectReference Include="$(MagicRoot)Core\Magic.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Magic.UnitTests" />
    <InternalsVisibleTo Include="Magic.IntegrationTests" />
  </ItemGroup>

  <!-- The gem, as the host sees it before constructing it (see Directory.Build.props). -->
  <PropertyGroup>
    <GemStatic>true</GemStatic>
    <Description>Entity component system built on flecs.</Description>
    <Authors>Konfus</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

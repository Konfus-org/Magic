<Project>

  <!-- Must come before the SDK props import: Directory.Build.props (imported by the SDK)
       switches this project to gem output settings when IsMagicGem is true. -->
  <PropertyGroup>
    <IsMagicGem>true</IsMagicGem>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The assembly is AssimpModels, not Assimp: the native library is assimp.dll and the two would overwrite each
         other in bin\Gems (case-insensitive). The namespace is AssimpGem so "Assimp.X" binds to the library. -->
    <RootNamespace>AssimpGem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false + ExcludeAssets=runtime: compile against the host, but never copy Magic.dll
         (or its dependencies) next to this gem. The gem's load context shares the host's
         already-loaded copy (see Gems.LoadContext); a second copy would be a different
         assembly identity and the host would not recognise the gem's [Gem] attribute. -->
    <ProjectReference Include="$(MagicRoot)Magic\Magic.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Magic.UnitTests" />
    <InternalsVisibleTo Include="Magic.IntegrationTests" />
  </ItemGroup>

  <!-- The gem, as the host sees it before constructing it (see Directory.Build.props). -->
  <PropertyGroup>
    <Description>Loads models with Assimp.</Description>
    <Authors>Konfus</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The project's own code, beside its .magic file. Its Run is Magic opening the project headless. -->
  <PropertyGroup>
    <RunCommand>$(MagicBin)Magic</RunCommand>
    <RunCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MagicBin)Magic.exe</RunCommand>
    <RunArguments>open "$(MSBuildProjectDirectory)/ProjectName.magic" --headless true</RunArguments>
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)../../</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built before the project so its Run has a Magic to start; nothing of it is referenced or copied. -->
    <ProjectReference
      Include="../../src/Launcher/Magic.Launcher.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
</Project>

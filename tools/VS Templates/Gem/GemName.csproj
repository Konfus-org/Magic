<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/GemName/GemName.dll when a project lists GemName. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>What GemName does for a project.</Description>
    <Version>1.0.0</Version>
    <!--#if (authors != "") -->
    <Authors>GemAuthors</Authors>
    <!--#endif -->
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its log. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

# Code style and analyzer rules. The build enforces them (EnforceCodeStyleInBuild) and treats every warning as an error
# but unused or unreachable code's (Directory.Build.props), so "warning" below means "the build fails" for all but
# those. Layout is CSharpier's: it reads the [*] block below, the editor's extension and tools/Scripts/Format.ps1 run
# it, and the build refuses a file it would change. The house rules no built-in rule covers are tools/Analyzers.
# Every code-quality rule is on (AnalysisMode All); the few that are off say why.

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{csproj,props,targets,slnx,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.cs]

# Files and usings. A namespace matches its folder: the project's root namespace, then each folder below the project
# (CODESTANDARDS Folders).
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning
csharp_using_directive_placement = outside_namespace
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

# An if or an else whose body is one statement has no braces, and a body that spans lines always has them
# (CODESTANDARDS Methods), checked in review: IDE0011 is off, since its when_multiline also asks braces of an else
# beside a braced if, and CSharpier adds none.
dotnet_diagnostic.IDE0011.severity = none

# var or the written type is the coder's choice; new() and [] when the type is already on the line
dotnet_diagnostic.IDE0008.severity = none
csharp_style_implicit_object_creation_when_type_is_apparent = true
dotnet_diagnostic.IDE0090.severity = warning
dotnet_style_collection_initializer = true
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_diagnostic.IDE0049.severity = warning

# Members
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = warning
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async
dotnet_diagnostic.IDE0036.severity = warning
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0009.severity = warning
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0044.severity = warning
csharp_style_prefer_readonly_struct = true
dotnet_diagnostic.IDE0250.severity = warning
csharp_style_prefer_readonly_struct_member = true
dotnet_diagnostic.IDE0251.severity = warning
dotnet_diagnostic.IDE0064.severity = warning
csharp_style_prefer_primary_constructors = true
dotnet_diagnostic.IDE0290.severity = warning
dotnet_style_prefer_auto_properties = true
dotnet_diagnostic.IDE0032.severity = warning
# A member that only returns or does one thing says it with =>: a property, indexer or accessor always, and a method,
# local function or operator whose body is one statement on one line
csharp_style_expression_bodied_methods = when_on_single_line
dotnet_diagnostic.IDE0022.severity = warning
csharp_style_expression_bodied_local_functions = when_on_single_line
dotnet_diagnostic.IDE0061.severity = warning
csharp_style_expression_bodied_operators = when_on_single_line
dotnet_diagnostic.IDE0023.severity = warning
dotnet_diagnostic.IDE0024.severity = warning
csharp_style_expression_bodied_properties = true
dotnet_diagnostic.IDE0025.severity = warning
csharp_style_expression_bodied_indexers = true
dotnet_diagnostic.IDE0026.severity = warning
csharp_style_expression_bodied_accessors = true
dotnet_diagnostic.IDE0027.severity = warning

# Dead, redundant and unused code. The unused and unreachable ones stay warnings in the build (Directory.Build.props),
# so code in flight compiles and runs.
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0002.severity = warning
dotnet_diagnostic.IDE0004.severity = warning
dotnet_diagnostic.IDE0035.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
csharp_style_unused_value_assignment_preference = discard_variable
dotnet_diagnostic.IDE0059.severity = warning
dotnet_code_quality_unused_parameters = all
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0080.severity = warning
dotnet_diagnostic.IDE0100.severity = warning
dotnet_diagnostic.IDE0110.severity = warning
dotnet_diagnostic.IDE0240.severity = warning
dotnet_diagnostic.IDE0241.severity = warning
dotnet_diagnostic.IDE0076.severity = warning
dotnet_diagnostic.IDE0077.severity = warning
dotnet_remove_unnecessary_suppression_exclusions = none
dotnet_diagnostic.IDE0079.severity = warning

# Mistakes the compiler lets through: missing enum cases, bad format strings, hidden casts, unclear precedence
dotnet_diagnostic.IDE0010.severity = warning
dotnet_diagnostic.IDE0072.severity = warning
dotnet_diagnostic.IDE0043.severity = warning
dotnet_style_prefer_foreach_explicit_cast_in_source = when_strongly_typed
dotnet_diagnostic.IDE0220.severity = warning
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity
dotnet_style_parentheses_in_other_operators = never_if_unnecessary
dotnet_diagnostic.IDE0047.severity = warning
dotnet_diagnostic.IDE0048.severity = warning

# Allocation and capture: no hidden closures, using declarations instead of nested blocks
csharp_prefer_static_local_function = true
dotnet_diagnostic.IDE0062.severity = warning
csharp_prefer_static_anonymous_function = true
dotnet_diagnostic.IDE0320.severity = warning
csharp_style_prefer_method_group_conversion = true
dotnet_diagnostic.IDE0200.severity = warning
csharp_prefer_simple_using_statement = true
dotnet_diagnostic.IDE0063.severity = warning
csharp_style_prefer_system_threading_lock = true
dotnet_diagnostic.IDE0330.severity = warning

# Simpler expressions
csharp_style_pattern_matching_over_as_with_null_check = true
dotnet_diagnostic.IDE0019.severity = warning
csharp_style_pattern_matching_over_is_with_cast_check = true
dotnet_diagnostic.IDE0020.severity = warning
dotnet_diagnostic.IDE0038.severity = warning
csharp_style_prefer_not_pattern = true
dotnet_diagnostic.IDE0083.severity = warning
csharp_style_prefer_pattern_matching = true
dotnet_diagnostic.IDE0078.severity = warning
csharp_style_prefer_null_check_over_type_check = true
dotnet_diagnostic.IDE0150.severity = warning
dotnet_style_coalesce_expression = true
dotnet_diagnostic.IDE0029.severity = warning
dotnet_diagnostic.IDE0030.severity = warning
dotnet_diagnostic.IDE0270.severity = warning
dotnet_style_null_propagation = true
dotnet_diagnostic.IDE0031.severity = warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true
dotnet_diagnostic.IDE0041.severity = warning
csharp_style_conditional_delegate_call = true
dotnet_diagnostic.IDE1005.severity = warning
csharp_style_inlined_variable_declaration = true
dotnet_diagnostic.IDE0018.severity = warning
dotnet_style_object_initializer = true
dotnet_diagnostic.IDE0017.severity = warning
csharp_prefer_simple_default_expression = true
dotnet_diagnostic.IDE0034.severity = warning
dotnet_style_prefer_simplified_interpolation = true
dotnet_diagnostic.IDE0071.severity = warning
dotnet_style_prefer_simplified_boolean_expressions = true
dotnet_diagnostic.IDE0075.severity = warning
dotnet_style_prefer_compound_assignment = true
dotnet_diagnostic.IDE0054.severity = warning
dotnet_diagnostic.IDE0074.severity = warning
csharp_style_prefer_local_over_anonymous_function = true
dotnet_diagnostic.IDE0039.severity = warning
dotnet_diagnostic.IDE0082.severity = warning
dotnet_diagnostic.IDE0280.severity = warning

# Naming: PascalCase types, members and constants, IPascalCase interfaces, TPascalCase type parameters,
# _camelCase private fields, camelCase locals and parameters
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = i_pascal_case
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.i_pascal_case.capitalization = pascal_case

dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = t_pascal_case
dotnet_naming_rule.type_parameters.severity = warning
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.t_pascal_case.required_prefix = T
dotnet_naming_style.t_pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_constants.symbols = private_constants
dotnet_naming_rule.private_constants.style = pascal_case
dotnet_naming_rule.private_constants.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_rule.local_constants.symbols = local_constants
dotnet_naming_rule.local_constants.style = pascal_case
dotnet_naming_rule.local_constants.severity = warning
dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const

dotnet_naming_rule.locals_and_parameters.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters.style = camel_case
dotnet_naming_rule.locals_and_parameters.severity = warning
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_rule.everything_else.symbols = everything_else
dotnet_naming_rule.everything_else.style = pascal_case
dotnet_naming_rule.everything_else.severity = warning
dotnet_naming_symbols.everything_else.applicable_kinds = namespace, class, struct, enum, delegate, event, method, property, field, local_function
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Async: ConfigureAwait(false) on every await, every task observed, no async void, no blocking waits,
# Async suffix on everything that returns a task
dotnet_diagnostic.CA2007.severity = warning
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD100.severity = warning
dotnet_diagnostic.VSTHRD101.severity = warning
dotnet_diagnostic.VSTHRD103.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.VSTHRD200.severity = warning
# Repeats CA2007.
dotnet_diagnostic.VSTHRD111.severity = none
# Guards JoinableTaskFactory code, which Magic has none of.
dotnet_diagnostic.VSTHRD003.severity = none

# Banned APIs (BannedSymbols.txt): what the standards say to use instead
dotnet_diagnostic.RS0030.severity = warning

# The house rules (tools/Analyzers): members in order (MG0001, CODESTANDARDS Type layout) and no null-forgiving !
# (MG0002, CODESTANDARDS Null). The analyzer ships its fix in its own assembly: the compiler makes only the rules, by
# attribute, and the editor and dotnet format, which make the fix, bring the Workspaces it needs.
dotnet_diagnostic.MG0001.severity = warning
dotnet_diagnostic.MG0002.severity = warning
dotnet_diagnostic.RS1038.severity = none

# Code-quality rules that are off
# Magic is used from C#: CLS compliance and other languages' keywords (End, Stop, Error) do not matter.
dotnet_diagnostic.CA1014.severity = none
dotnet_diagnostic.CA1716.severity = none
# Nullable reference types check arguments for null at compile time.
dotnet_diagnostic.CA1062.severity = none
# Engine text is not localized.
dotnet_diagnostic.CA1303.severity = none
# XML docs go on types and non-obvious members, not every public one (CODESTANDARDS Comments).
dotnet_diagnostic.CS1591.severity = none
# Magic is an executable whose public types are the API gems compile against; a test class is public for xunit.
dotnet_diagnostic.CA1515.severity = none
# A public type may nest in the type it belongs to; where it goes is the coder's call. Extension blocks (CODESTANDARDS
# Extensions) compile to nested types too.
dotnet_diagnostic.CA1034.severity = none
# Enum values in blocks or ranges are not flags; CA2217 still checks the enums that say they are.
dotnet_diagnostic.CA1027.severity = none
# An enum can be stored in a smaller type, to pack the data it is in.
dotnet_diagnostic.CA1028.severity = none
# Its list of namespaces to avoid is .NET Framework's, most of which .NET 10 does not have.
dotnet_diagnostic.CA1724.severity = none
# Data structs keep their public fields (CODESTANDARDS State), so an ECS component's can be written through a span.
dotnet_code_quality.CA1051.exclude_structs = true

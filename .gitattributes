* text=auto eol=lf

# Assets git must never treat as text: no line endings converted, no diff attempted.
*.fbx binary
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tga binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.otf binary
*.ttf binary

# The forest's chunks: text, but a hundred thousand generated placements no diff should show.
samples/Forest/Domains/Forest/*_0_*.prefab -diff

# The terrain sample's landscape: ten thousand generated tree placements.
samples/Terrain/Domains/Terrain/landscape.prefab -diff

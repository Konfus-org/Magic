<Project>
  <!-- Native libraries. A project declares what it binds with a NativeLibrary item: the library's logical name (what
       DllImport names and the gem load context resolves), the headers to read and how C names map to C# ones. How
       each library is had is natives/CMakeLists.txt's: one CMake superbuild for every library, which this file runs
       (natives/README.md), and which puts them under one folder per machine (MagicNativeLibs), shared by every
       checkout. From there the build generates the C# API from the headers (tools/NativeBindingsGenerator) into the
       intermediate folder and compiles it in, and copies the library beside the assembly under runtimes/<rid>/native/,
       where the gem load context finds it. Every item's include folder serves every generation in the project, so a
       library whose headers include another's declares that one too; an item with no Headers is bound by hand and
       declared for its binary alone, and one declared HeadersOnly is read for its headers alone. -->
  <PropertyGroup>
    <MagicNativeLibs Condition="'$(MagicNativeLibs)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))/Magic/NativeLibs/</MagicNativeLibs>
    <MagicNativeRid>$(NETCoreSdkRuntimeIdentifier)</MagicNativeRid>
    <MagicNativeSuperbuild>$(MSBuildThisFileDirectory)natives/</MagicNativeSuperbuild>
    <MagicNativeSuperbuildOutput>$(MSBuildThisFileDirectory)Build/natives/</MagicNativeSuperbuildOutput>
    <MagicNativeBindingsGenerator>$(MSBuildThisFileDirectory)tools/NativeBindingsGenerator/NativeBindingsGenerator.csproj</MagicNativeBindingsGenerator>
    <MagicNativeBindingsGeneratorDll>$(MSBuildThisFileDirectory)Build/bin/$(Configuration)/Tools/NativeBindingsGenerator/NativeBindingsGenerator.dll</MagicNativeBindingsGeneratorDll>
    <MagicNativeSysroot>$(MSBuildThisFileDirectory)tools/NativeBindingsGenerator/Sysroot/</MagicNativeSysroot>
    <!-- A shared library's file name, as the OS names one (SDL3.dll, libSDL3.so, libSDL3.dylib). -->
    <MagicNativePrefix Condition="!$([MSBuild]::IsOSPlatform('Windows'))">lib</MagicNativePrefix>
    <MagicNativeSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.dll</MagicNativeSuffix>
    <MagicNativeSuffix Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</MagicNativeSuffix>
    <MagicNativeSuffix Condition="'$(MagicNativeSuffix)' == ''">.so</MagicNativeSuffix>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <NativeLibrary>
      <Namespace>$(RootNamespace)</Namespace>
      <Headers />
      <IncludePath />
      <Defines />
      <Prefixes />
      <Class />
      <Shims />
      <HeadersOnly>false</HeadersOnly>
    </NativeLibrary>
  </ItemDefinitionGroup>

  <!-- Where each library's source and product live, and what this project makes from it. -->
  <Target Name="_LocateNativeLibraries" Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <NativeLibrary>
        <Checkout>$(MagicNativeLibs)%(Identity)/source/</Checkout>
        <Native>$(MagicNativeLibs)%(Identity)/built/native/$(MagicNativePrefix)%(Identity)$(MagicNativeSuffix)</Native>
        <Response>$(IntermediateOutputPath)%(Identity).bindings.rsp</Response>
        <Generated>$(IntermediateOutputPath)%(Identity).g.cs</Generated>
      </NativeLibrary>
    </ItemGroup>
    <ItemGroup>
      <_NativeBinary Include="@(NativeLibrary)" Condition="'%(NativeLibrary.HeadersOnly)' != 'true'" />
      <_NativeInclude Include="@(NativeLibrary)" Condition="'%(NativeLibrary.IncludePath)' != ''" />
      <_NativeGenerated Include="@(NativeLibrary)" Condition="'%(NativeLibrary.Headers)' != ''" />
    </ItemGroup>
    <PropertyGroup>
      <_NativeIncludeFolders>@(_NativeInclude->'%(Checkout)%(IncludePath)', ',')</_NativeIncludeFolders>
    </PropertyGroup>
  </Target>

  <!-- Runs the superbuild: CMake configures it from natives/ into Build/natives/ and builds it one library at a time,
       each library's own build on the cores the caller allows, below normal priority, so a long native build never
       makes the machine unusable. A hash of the superbuild's files names a ready marker in the shared folder, so the
       superbuild runs again only when one of them changed or a library is missing, and a build cut short leaves no
       marker; CMake's own stamps then resume it at the step that did not finish. One build at a time, machine-wide:
       several checkouts share the folder, so all native work holds one named mutex, and whoever comes second finds
       the marker. On Windows CMake runs inside Visual Studio's developer environment, which brings its compiler, CMake
       and Ninja; elsewhere they come from the PATH. -->
  <UsingTask TaskName="BuildNativeLibraries" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Natives ParameterType="System.String" Required="true" />
      <Superbuild ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
      <Rid ParameterType="System.String" Required="true" />
      <Cores ParameterType="System.Int32" />
      <Files ParameterType="System.String" />
      <Built ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Threading" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Fragment" Language="cs"><![CDATA[
string natives = Natives.Replace('\\', '/').TrimEnd('/');
string superbuild = Superbuild.Replace('\\', '/').TrimEnd('/');
string output = Output.Replace('\\', '/').TrimEnd('/');
string[] files = (Files ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
bool windows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
int cores = Cores > 0 ? Cores : Math.Max(1, Environment.ProcessorCount / 2);

// Runs a command, after the developer environment where there is one, and keeps what it printed. The lines that say
// error come first in a failure's message, then the last ones: a compiler's error is rarely among the last lines.
bool Run(string environment, string file, string arguments, System.Collections.Generic.List<string> lines, string code)
{
    System.Diagnostics.ProcessStartInfo start = environment == null
        ? new System.Diagnostics.ProcessStartInfo(file, arguments)
        : new System.Diagnostics.ProcessStartInfo("cmd.exe", "/c \"" + environment + " >nul 2>&1 && " + file + " " + arguments + "\"");
    start.UseShellExecute = false;
    start.RedirectStandardOutput = true;
    start.RedirectStandardError = true;
    start.WorkingDirectory = natives;
    start.Environment["CMAKE_BUILD_PARALLEL_LEVEL"] = cores.ToString();
    if (windows)
    {
        // A library's test data can run past Windows' path limit (HarfBuzz's does), which git refuses unless told: told
        // here for every git the build runs, the submodules' included, and nowhere else.
        start.Environment["GIT_CONFIG_COUNT"] = "1";
        start.Environment["GIT_CONFIG_KEY_0"] = "core.longpaths";
        start.Environment["GIT_CONFIG_VALUE_0"] = "true";
    }
    try
    {
        using (System.Diagnostics.Process process = System.Diagnostics.Process.Start(start))
        {
            try
            {
                process.PriorityClass = System.Diagnostics.ProcessPriorityClass.BelowNormal;
            }
            catch (InvalidOperationException)
            {
            }

            process.OutputDataReceived += (sender, e) => { if (e.Data != null) { lock (lines) { lines.Add(e.Data); } } };
            process.ErrorDataReceived += (sender, e) => { if (e.Data != null) { lock (lines) { lines.Add(e.Data); } } };
            process.BeginOutputReadLine();
            process.BeginErrorReadLine();
            process.WaitForExit();
            foreach (string line in lines)
            {
                Log.LogMessage(MessageImportance.Low, line);
            }

            if (process.ExitCode == 0)
            {
                return true;
            }

            System.Collections.Generic.IEnumerable<string> errors = lines.Where(line => line.IndexOf("error", StringComparison.OrdinalIgnoreCase) >= 0 && line.IndexOf("warning", StringComparison.OrdinalIgnoreCase) < 0).Take(40);
            Log.LogError("", code, "", "", 0, 0, 0, 0, "{0} {1} failed:\n{2}\n...\n{3}", file, arguments, string.Join("\n", errors), string.Join("\n", lines.Skip(Math.Max(0, lines.Count - 15))));
            return false;
        }
    }
    catch (System.ComponentModel.Win32Exception)
    {
        Log.LogError("", code, "", "", 0, 0, 0, 0, "{0} was not found: building the native libraries needs git, CMake, Ninja, Python 3 and a C++ toolchain (README).", file);
        return false;
    }
}

// Visual Studio's developer environment for the architecture built for, found through its installer's vswhere: the
// command every CMake call runs after, which puts its compiler, CMake and Ninja on the PATH.
string DeveloperEnvironment()
{
    string vswhere = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86), "Microsoft Visual Studio", "Installer", "vswhere.exe");
    System.Collections.Generic.List<string> lines = new System.Collections.Generic.List<string>();
    if (!File.Exists(vswhere) || !Run(null, vswhere, "-latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath", lines, "BND017") || lines.Count == 0)
    {
        Log.LogError("", "BND017", "", "", 0, 0, 0, 0, "Building the native libraries needs Visual Studio with its \"Desktop development with C++\" workload (README).");
        return null;
    }

    string devCmd = Path.Combine(lines[0].Trim(), "Common7", "Tools", "VsDevCmd.bat");
    string arch = Rid.EndsWith("arm64", StringComparison.Ordinal) ? "arm64" : "x64";
    string host = RuntimeInformation.OSArchitecture == Architecture.Arm64 ? "arm64" : "x64";
    return "call \"" + devCmd + "\" -arch=" + arch + " -host_arch=" + host + " -no_logo";
}

// The superbuild's files, its README aside, name the marker: a change to any of them is a build again.
string hash;
using (System.Security.Cryptography.SHA256 sha256 = System.Security.Cryptography.SHA256.Create())
using (MemoryStream all = new MemoryStream())
{
    foreach (string path in Directory.GetFiles(superbuild, "*", SearchOption.AllDirectories).Where(path => !path.EndsWith(".md", StringComparison.OrdinalIgnoreCase)).OrderBy(path => path, StringComparer.Ordinal))
    {
        byte[] name = System.Text.Encoding.UTF8.GetBytes(path.Substring(superbuild.Length).Replace('\\', '/'));
        all.Write(name, 0, name.Length);
        byte[] content = File.ReadAllBytes(path);
        all.Write(content, 0, content.Length);
    }

    hash = BitConverter.ToString(sha256.ComputeHash(all.ToArray())).Replace("-", "").Substring(0, 16);
}

string marker = Path.Combine(natives, "ready." + hash);
Func<bool> ready = () => File.Exists(marker) && files.All(File.Exists);
if (!ready())
{
    using (Mutex mutex = new Mutex(false, "Magic.Natives"))
    {
        try
        {
            mutex.WaitOne();
        }
        catch (AbandonedMutexException)
        {
        }

        try
        {
            if (!ready())
            {
                Directory.CreateDirectory(natives);
                Directory.CreateDirectory(output);
                string environment = windows ? DeveloperEnvironment() : null;
                if (!windows || environment != null)
                {
                    Log.LogMessage(MessageImportance.High, "Building the native libraries under {0}: each once per machine, again when its pin or options change.", natives);
                    System.Collections.Generic.List<string> lines = new System.Collections.Generic.List<string>();
                    if (Run(environment, "cmake", "-S \"" + superbuild + "\" -B \"" + output + "\" -G Ninja \"-DMAGIC_NATIVES=" + natives + "\" -DMAGIC_RID=" + Rid, lines, "BND015")
                        && Run(environment, "cmake", "--build \"" + output + "\" --parallel 1", lines, "BND015"))
                    {
                        foreach (string old in Directory.GetFiles(natives, "ready.*"))
                        {
                            File.Delete(old);
                        }

                        File.WriteAllText(marker, "");
                    }
                }
            }
        }
        finally
        {
            mutex.ReleaseMutex();
        }
    }
}

if (Log.HasLoggedErrors)
{
    return false;
}

foreach (string file in files.Where(file => !File.Exists(file)))
{
    Log.LogError("", "BND016", "", "", 0, 0, 0, 0, "The native libraries built, but there is no {0}: natives/CMakeLists.txt makes no such library.", file);
}

Built = files.Select(file => (ITaskItem)new TaskItem(file)).ToArray();
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PrepareNativeLibraries" DependsOnTargets="_LocateNativeLibraries" Condition="'@(NativeLibrary)' != ''">
    <BuildNativeLibraries Natives="$(MagicNativeLibs)" Superbuild="$(MagicNativeSuperbuild)" Output="$(MagicNativeSuperbuildOutput)"
                          Rid="$(MagicNativeRid)" Cores="$(MagicNativeCores)" Files="@(_NativeBinary->'%(Native)')">
      <Output TaskParameter="Built" ItemName="_NativeBuilt" />
    </BuildNativeLibraries>
  </Target>

  <!-- The generated API joins the compile, and the libraries join the output, before the build assigns output paths,
       so a project referencing this one copies them too. -->
  <Target Name="_AddNativeLibraryItems" DependsOnTargets="PrepareNativeLibraries" BeforeTargets="AssignTargetPaths;CoreCompile" Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <None Include="@(_NativeBuilt)" Link="runtimes/$(MagicNativeRid)/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <Compile Include="@(_NativeGenerated->'%(Generated)');$(IntermediateOutputPath)NativeLibraries.g.cs" Visible="false" />
      <FileWrites Include="@(_NativeGenerated->'%(Generated)');@(_NativeGenerated->'%(Response)');$(IntermediateOutputPath)NativeLibraries.g.cs" />
    </ItemGroup>
    <!-- Nothing crosses to C marshalled: every call is blittable (a C bool is one byte), so each is a direct call. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeLibraries.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;[assembly: System.Runtime.CompilerServices.DisableRuntimeMarshalling]" />
    <WriteLinesToFile File="%(_NativeGenerated.Response)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="--library=%(_NativeGenerated.Identity);--namespace=%(_NativeGenerated.Namespace);--root=%(_NativeGenerated.Checkout);--headers=$([System.String]::Copy('%(_NativeGenerated.Headers)').Replace(';', ','));--include=$([System.String]::Copy('%(_NativeGenerated.IncludePath)').Replace(';', ','));--include-absolute=$(_NativeIncludeFolders);--defines=$([System.String]::Copy('%(_NativeGenerated.Defines)').Replace(';', ','));--prefixes=$([System.String]::Copy('%(_NativeGenerated.Prefixes)').Replace(';', ','));--class=%(_NativeGenerated.Class);--shims=$([System.String]::Copy('%(_NativeGenerated.Shims)').Replace(';', ','));--sysroot=$(MagicNativeSysroot);--output=%(_NativeGenerated.Generated)" />
  </Target>

  <!-- Generation reruns when a library's binary changed (a new pin brings new headers with it), the item changed or the
       generator did. -->
  <Target Name="GenerateNativeBindings" DependsOnTargets="_AddNativeLibraryItems" BeforeTargets="CoreCompile" Condition="'@(NativeLibrary)' != ''"
          Inputs="@(_NativeBuilt);@(_NativeGenerated->'%(Response)');$(MagicNativeBindingsGeneratorDll)" Outputs="@(_NativeGenerated->'%(Generated)')">
    <Exec Command="dotnet &quot;$(MagicNativeBindingsGeneratorDll)&quot; @&quot;%(_NativeGenerated.Response)&quot;" />
  </Target>

  <!-- The generator is built here rather than referenced, so a project built alone and the solution take the same path;
       in the same configuration, so it lands with what it builds for, and a solution build, which builds it too, builds
       it once. Built this way it is restored by nothing else, and a restore is per configuration, so it is restored
       first, in a pass of its own (the session id), as dotnet build does before it builds. -->
  <Target Name="_BuildNativeBindingsGenerator" BeforeTargets="GenerateNativeBindings" Condition="'@(NativeLibrary)' != '' and '$(MSBuildProjectFullPath)' != '$(MagicNativeBindingsGenerator)'">
    <MSBuild Projects="$(MagicNativeBindingsGenerator)" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(MagicNativeBindingsGenerator)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>

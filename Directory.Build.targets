<Project>
  <!-- Native libraries. A project declares one with a NativeLibrary item: the library's logical name (what DllImport
       names and the gem load context resolves), its repository and the commit or tag to build, the headers to read and
       how C names map to C# ones, and the CMake options to build it with. The build clones the repository at that
       commit with its submodules, builds it with CMake for this machine, generates the C# API from the headers
       (tools/NativeBindingsGenerator) into the intermediate folder and compiles it in, and puts the library beside the
       assembly under runtimes/<rid>/native/, where the gem load context finds it. Every item's include folder serves
       every generation in the project, so a library whose headers include another's declares that one too; an item
       with no Headers is built for its binary alone, and one with no Cmake is cloned for its headers alone.

       Items are taken in order, so a library comes after what it builds on, whose build folder is written
       {built:<name>} in its options; {source} is the library's own source. CmakeTarget names one CMake target to build
       where the whole project is more than the library. Source is the folder of the checkout holding CMakeLists.txt
       when that is not the root. A header the library's own build would generate from a template (a CMake config.h) is
       made by Shims, as header=template, with every option off.

       Everything lands under Build/NativeLibs/<name>/ (MagicNativeLibs moves it): the source, the build and what it
       built, with empty Directory.Build files beside them so Magic's own build rules stop at the folder. A library is cloned and built once per commit and options; generation reruns only when the library, the
       item or the generator changed. The machine needs git, CMake and a C++ toolchain (README). -->
  <PropertyGroup>
    <MagicNativeLibs Condition="'$(MagicNativeLibs)' == ''">$(MSBuildThisFileDirectory)Build/NativeLibs/</MagicNativeLibs>
    <MagicNativeRid>$(NETCoreSdkRuntimeIdentifier)</MagicNativeRid>
    <MagicNativeBindingsGenerator>$(MSBuildThisFileDirectory)tools/NativeBindingsGenerator/NativeBindingsGenerator.csproj</MagicNativeBindingsGenerator>
    <MagicNativeBindingsGeneratorDll>$(MSBuildThisFileDirectory)Build/bin/$(Configuration)/Tools/NativeBindingsGenerator/NativeBindingsGenerator.dll</MagicNativeBindingsGeneratorDll>
    <MagicNativeSysroot>$(MSBuildThisFileDirectory)tools/NativeBindingsGenerator/Sysroot/</MagicNativeSysroot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <NativeLibrary>
      <Namespace>$(RootNamespace)</Namespace>
      <Headers />
      <IncludePath />
      <Defines />
      <Prefixes />
      <Class />
      <Shims />
      <Source />
      <Cmake />
      <CmakeTarget />
    </NativeLibrary>
  </ItemDefinitionGroup>

  <!-- Where each library's source, build and product live, and what this project makes from it. -->
  <Target Name="_LocateNativeLibraries" Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <NativeLibrary>
        <Folder>$(MagicNativeLibs)%(Identity)/</Folder>
        <Checkout>$(MagicNativeLibs)%(Identity)/source/</Checkout>
        <Built>$(MagicNativeLibs)%(Identity)/built/</Built>
        <Response>$(IntermediateOutputPath)%(Identity).bindings.rsp</Response>
        <Generated>$(IntermediateOutputPath)%(Identity).g.cs</Generated>
      </NativeLibrary>
    </ItemGroup>
    <Error Code="BND010" Condition="'%(NativeLibrary.Repository)' == '' or '%(NativeLibrary.Commit)' == ''"
           Text="NativeLibrary %(NativeLibrary.Identity) needs Repository and Commit." />
    <ItemGroup>
      <_NativeInclude Include="@(NativeLibrary)" Condition="'%(NativeLibrary.IncludePath)' != ''" />
      <_NativeGenerated Include="@(NativeLibrary)" Condition="'%(NativeLibrary.Headers)' != ''" />
    </ItemGroup>
    <PropertyGroup>
      <_NativeBuiltFolders>@(NativeLibrary->'%(Identity)=%(Built)', ';')</_NativeBuiltFolders>
      <_NativeIncludeFolders>@(_NativeInclude->'%(Checkout)%(IncludePath)', ',')</_NativeIncludeFolders>
    </PropertyGroup>
  </Target>

  <!-- Cloned and built by one build at a time: several projects may declare the same library, so each library's work
       holds a machine-wide mutex named for it, and whoever comes second finds the marker. The source is fetched shallow
       at the commit, with its submodules; a changed commit fetches afresh, and a changed commit or options builds afresh,
       in Release, then the shared library named as the OS names one (cimgui.dll, libcimgui.so, libcimgui.dylib) is
       copied under built/native/, where the build picks it up. -->
  <UsingTask TaskName="PrepareNativeLibrary" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Name ParameterType="System.String" Required="true" />
      <Repository ParameterType="System.String" Required="true" />
      <Commit ParameterType="System.String" Required="true" />
      <Folder ParameterType="System.String" Required="true" />
      <Source ParameterType="System.String" />
      <Options ParameterType="System.String" />
      <CmakeTarget ParameterType="System.String" />
      <Built ParameterType="System.String" />
      <Produced ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <Marker ParameterType="Microsoft.Build.Framework.ITaskItem" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Threading" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Fragment" Language="cs"><![CDATA[
string checkout = Path.Combine(Folder, "source");
string source = string.IsNullOrEmpty(Source) ? checkout : Path.Combine(checkout, Source);
string build = Path.Combine(Folder, "build");
string built = Path.Combine(Folder, "built");
string native = Path.Combine(built, "native");
string options = (Options ?? "").Replace("{source}", source.TrimEnd('/', '\\'));
foreach (string pair in (Built ?? "").Split(';'))
{
    int equals = pair.IndexOf('=');
    if (equals > 0)
    {
        options = options.Replace("{built:" + pair.Substring(0, equals) + "}", pair.Substring(equals + 1).TrimEnd('/', '\\'));
    }
}

string optionsHash;
using (System.Security.Cryptography.SHA256 sha256 = System.Security.Cryptography.SHA256.Create())
{
    optionsHash = BitConverter.ToString(sha256.ComputeHash(System.Text.Encoding.UTF8.GetBytes(options + "\n" + (CmakeTarget ?? "")))).Replace("-", "").Substring(0, 16);
}

string marker = Path.Combine(Folder, string.Concat(Commit.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c)) + "." + optionsHash + ".ready");

bool Run(string file, string arguments, string workingDirectory, string code)
{
    System.Diagnostics.ProcessStartInfo start = new System.Diagnostics.ProcessStartInfo(file, arguments) { UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true, WorkingDirectory = workingDirectory };
    System.Collections.Generic.List<string> lines = new System.Collections.Generic.List<string>();
    try
    {
        using (System.Diagnostics.Process process = System.Diagnostics.Process.Start(start))
        {
            process.OutputDataReceived += (sender, e) => { if (e.Data != null) { lock (lines) { lines.Add(e.Data); } } };
            process.ErrorDataReceived += (sender, e) => { if (e.Data != null) { lock (lines) { lines.Add(e.Data); } } };
            process.BeginOutputReadLine();
            process.BeginErrorReadLine();
            process.WaitForExit();
            foreach (string line in lines)
            {
                Log.LogMessage(MessageImportance.Low, line);
            }

            if (process.ExitCode != 0)
            {
                // The lines that say error, then the last ones: a compiler's error is rarely among the last lines.
                System.Collections.Generic.IEnumerable<string> errors = lines.Where(line => line.IndexOf("error", StringComparison.OrdinalIgnoreCase) >= 0 && line.IndexOf("warning", StringComparison.OrdinalIgnoreCase) < 0).Take(40);
                Log.LogError("", code, "", "", 0, 0, 0, 0, "{0} failed for {1} ({0} {2}):\n{3}\n...\n{4}", file, Name, arguments, string.Join("\n", errors), string.Join("\n", lines.Skip(Math.Max(0, lines.Count - 15))));
                return false;
            }

            return true;
        }
    }
    catch (System.ComponentModel.Win32Exception)
    {
        Log.LogError("", code, "", "", 0, 0, 0, 0, "{0} was not found: building {1} needs git, CMake and a C++ toolchain on the PATH (see README).", file, Name);
        return false;
    }
}

using (Mutex mutex = new Mutex(false, "Magic.Natives." + Name.Replace('/', '_')))
{
    try
    {
        mutex.WaitOne();
    }
    catch (AbandonedMutexException)
    {
    }

    try
    {
        if (!File.Exists(marker))
        {
            bool ready = true;
            string stamp = Path.Combine(checkout, ".magic-commit");
            if (!Directory.Exists(checkout) || !File.Exists(stamp) || !string.Equals(File.ReadAllText(stamp), Commit, StringComparison.Ordinal))
            {
                Log.LogMessage(MessageImportance.High, "Fetching {0} at {1} from {2}", Name, Commit, Repository);
                foreach (string folder in new[] { checkout, build, built })
                {
                    if (Directory.Exists(folder))
                    {
                        Directory.Delete(folder, true);
                    }
                }

                Directory.CreateDirectory(checkout);
                ready = Run("git", "init --quiet", checkout, "BND019")
                    && Run("git", "config core.longpaths true", checkout, "BND019")
                    && Run("git", "remote add origin \"" + Repository + "\"", checkout, "BND019")
                    && Run("git", "fetch --quiet --depth 1 origin \"" + Commit + "\"", checkout, "BND019")
                    && Run("git", "checkout --quiet FETCH_HEAD", checkout, "BND019")
                    && Run("git", "submodule update --init --recursive --depth 1 --quiet", checkout, "BND019");
                if (ready)
                {
                    File.WriteAllText(stamp, Commit);
                }
            }

            if (ready && !string.IsNullOrEmpty(Options))
            {
                Log.LogMessage(MessageImportance.High, "Building {0} with CMake; this happens once per commit and options.", Name);

                // The libraries build under the repository, where MSBuild would otherwise find Magic's own build files
                // and apply its rules (warnings as errors, output folders) to their Visual Studio projects: empty ones
                // beside them end that search.
                string libraries = Path.GetDirectoryName(Folder.TrimEnd('/', '\\'));
                foreach (string stop in new[] { "Directory.Build.props", "Directory.Build.targets" })
                {
                    string path = Path.Combine(libraries, stop);
                    if (!File.Exists(path))
                    {
                        File.WriteAllText(path, "<Project />\n");
                    }
                }

                foreach (string folder in new[] { build, built })
                {
                    if (Directory.Exists(folder))
                    {
                        Directory.Delete(folder, true);
                    }
                }

                Directory.CreateDirectory(build);
                Directory.CreateDirectory(built);
                string target = string.IsNullOrEmpty(CmakeTarget) ? "" : " --target " + CmakeTarget;
                ready = Run("cmake", "-S \"" + source + "\" -B \"" + build + "\" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"" + built + "\" " + options, Folder, "BND015")
                    && Run("cmake", "--build \"" + build + "\" --config Release --parallel" + target, Folder, "BND015")
                    && (!string.IsNullOrEmpty(CmakeTarget) || Run("cmake", "--install \"" + build + "\" --config Release", Folder, "BND015"));
                if (ready)
                {
                    string file = RuntimeInformation.IsOSPlatform(OSPlatform.Windows) ? Name + ".dll" : RuntimeInformation.IsOSPlatform(OSPlatform.OSX) ? "lib" + Name + ".dylib" : "lib" + Name + ".so";
                    string found = Directory.GetFiles(built, file, SearchOption.AllDirectories).FirstOrDefault() ?? Directory.GetFiles(build, file, SearchOption.AllDirectories).FirstOrDefault();
                    if (found == null)
                    {
                        Log.LogError("", "BND016", "", "", 0, 0, 0, 0, "{0} built, but no {1} came of it under {2}.", Name, file, Folder);
                        ready = false;
                    }
                    else
                    {
                        Directory.CreateDirectory(native);
                        File.Copy(found, Path.Combine(native, file), true);
                    }
                }
            }

            if (ready)
            {
                foreach (string old in Directory.GetFiles(Folder, "*.ready"))
                {
                    File.Delete(old);
                }

                File.WriteAllText(marker, "");
            }
        }

        Produced = Directory.Exists(native) ? Directory.GetFiles(native).Select(path => (ITaskItem)new TaskItem(path)).ToArray() : new ITaskItem[0];
        Marker = new TaskItem(marker);
    }
    finally
    {
        mutex.ReleaseMutex();
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PrepareNativeLibraries" DependsOnTargets="_LocateNativeLibraries" Condition="'@(NativeLibrary)' != ''">
    <PrepareNativeLibrary Name="%(NativeLibrary.Identity)" Repository="%(NativeLibrary.Repository)" Commit="%(NativeLibrary.Commit)" Folder="%(NativeLibrary.Folder)"
                          Source="%(NativeLibrary.Source)" Options="%(NativeLibrary.Cmake)" CmakeTarget="%(NativeLibrary.CmakeTarget)" Built="$(_NativeBuiltFolders)">
      <Output TaskParameter="Produced" ItemName="_NativeBuilt" />
      <Output TaskParameter="Marker" ItemName="_NativeReady" />
    </PrepareNativeLibrary>
  </Target>

  <!-- The generated API joins the compile, and the libraries join the output, before the build assigns output paths,
       so a project referencing this one copies them too. -->
  <Target Name="_AddNativeLibraryItems" DependsOnTargets="PrepareNativeLibraries" BeforeTargets="AssignTargetPaths;CoreCompile" Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <None Include="@(_NativeBuilt)" Link="runtimes/$(MagicNativeRid)/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <Compile Include="@(_NativeGenerated->'%(Generated)');$(IntermediateOutputPath)NativeLibraries.g.cs" Visible="false" />
      <FileWrites Include="@(_NativeGenerated->'%(Generated)');@(_NativeGenerated->'%(Response)');$(IntermediateOutputPath)NativeLibraries.g.cs" />
    </ItemGroup>
    <!-- Nothing crosses to C marshalled: every call is blittable (a C bool is one byte), so each is a direct call. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeLibraries.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;[assembly: System.Runtime.CompilerServices.DisableRuntimeMarshalling]" />
    <WriteLinesToFile File="%(_NativeGenerated.Response)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="--library=%(_NativeGenerated.Identity);--namespace=%(_NativeGenerated.Namespace);--root=%(_NativeGenerated.Checkout);--headers=$([System.String]::Copy('%(_NativeGenerated.Headers)').Replace(';', ','));--include=$([System.String]::Copy('%(_NativeGenerated.IncludePath)').Replace(';', ','));--include-absolute=$(_NativeIncludeFolders);--defines=$([System.String]::Copy('%(_NativeGenerated.Defines)').Replace(';', ','));--prefixes=$([System.String]::Copy('%(_NativeGenerated.Prefixes)').Replace(';', ','));--class=%(_NativeGenerated.Class);--shims=$([System.String]::Copy('%(_NativeGenerated.Shims)').Replace(';', ','));--sysroot=$(MagicNativeSysroot);--output=%(_NativeGenerated.Generated)" />
  </Target>

  <Target Name="GenerateNativeBindings" DependsOnTargets="_AddNativeLibraryItems" BeforeTargets="CoreCompile" Condition="'@(NativeLibrary)' != ''"
          Inputs="@(_NativeReady);@(_NativeGenerated->'%(Response)');$(MagicNativeBindingsGeneratorDll)" Outputs="@(_NativeGenerated->'%(Generated)')">
    <Exec Command="dotnet &quot;$(MagicNativeBindingsGeneratorDll)&quot; @&quot;%(_NativeGenerated.Response)&quot;" />
  </Target>

  <!-- The generator is built here rather than referenced, so a project built alone and the solution take the same path;
       in the same configuration, so it lands with what it builds for, and a solution build, which builds it too, builds
       it once. Built this way it is restored by nothing else, and a restore is per configuration, so it is restored
       first, in a pass of its own (the session id), as dotnet build does before it builds. -->
  <Target Name="_BuildNativeBindingsGenerator" BeforeTargets="GenerateNativeBindings" Condition="'@(NativeLibrary)' != '' and '$(MSBuildProjectFullPath)' != '$(MagicNativeBindingsGenerator)'">
    <MSBuild Projects="$(MagicNativeBindingsGenerator)" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(MagicNativeBindingsGenerator)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>

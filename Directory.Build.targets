<Project>
  <!-- Native libraries. A project declares each C library it binds with a NativeLibrary item, and the item says all of
       it: where the library comes from, how CMake builds it, and what is bound of it, its headers and how C names map
       to C# ones (src/Bundled/Gems/README.md#native-libraries). The build writes the project's items as one CMake
       superbuild, an ExternalProject each, and builds what is not built yet into one folder per machine
       (MagicNativeLibs), shared by every checkout. From there it generates the C# API from the headers
       (tools/NativeBindingsGenerator, or Microsoft's ClangSharpPInvokeGenerator for an item that names it) into the
       intermediate folder and compiles it in, and copies the library beside the assembly under runtimes/<rid>/native/,
       where the gem load context finds it. Every item's include folder serves every generation in the project, so a
       library whose headers include another's declares that one too; an item with no Headers is bound by hand and
       declared for its binary alone, and one declared HeadersOnly is fetched for its headers and sources alone.
       Building and generating are a real build's work, never a design-time one's: the build an IDE runs in the
       background to feed its editor compiles what the last real build generated. It hides what it logs, so a native
       build in it would run unseen. -->
  <PropertyGroup>
    <MagicNativeLibs Condition="'$(MagicNativeLibs)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))/Magic/NativeLibs/</MagicNativeLibs>
    <!-- With forward slashes, as CMake writes paths, so an option a project makes of it reads as CMake recorded it. -->
    <MagicNativeLibs>$([MSBuild]::EnsureTrailingSlash('$(MagicNativeLibs)').Replace('\', '/'))</MagicNativeLibs>
    <MagicNativeRid>$(NETCoreSdkRuntimeIdentifier)</MagicNativeRid>
    <MagicNativeSuperbuild>$(IntermediateOutputPath)natives/</MagicNativeSuperbuild>
    <MagicNativeBindingsGenerator>$(MSBuildThisFileDirectory)tools/NativeBindingsGenerator/NativeBindingsGenerator.csproj</MagicNativeBindingsGenerator>
    <!-- Where the generator's own build puts it (Directory.Build.props), in this build's Magic folder. -->
    <MagicNativeBindingsGeneratorDll>$(MagicBin)Tools/NativeBindingsGenerator/NativeBindingsGenerator.dll</MagicNativeBindingsGeneratorDll>
    <MagicNativeSysroot>$(MSBuildThisFileDirectory)tools/NativeBindingsGenerator/Sysroot/</MagicNativeSysroot>
    <!-- Microsoft's generator: the native tool the restore downloads for this machine's runtime, and the one target
         every machine reads the headers for, so what it writes is the same on every platform. Its package is named
         for the SDK's portable runtime, as a distribution's own SDK names its runtime for the distribution
         (ubuntu.26.04-x64), which no package is published for. -->
    <MagicClangSharpRid>$(NETCoreSdkPortableRuntimeIdentifier)</MagicClangSharpRid>
    <MagicClangSharpGenerator>$(NuGetPackageRoot)clangsharppinvokegenerator.$(MagicClangSharpRid)/$(ClangSharpPInvokeGeneratorVersion)/tools/any/$(MagicClangSharpRid)/ClangSharpPInvokeGenerator</MagicClangSharpGenerator>
    <MagicClangSharpGenerator Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MagicClangSharpGenerator).exe</MagicClangSharpGenerator>
    <MagicNativeBindingsTarget>x86_64-pc-windows-msvc</MagicNativeBindingsTarget>
    <!-- A shared library's file name, as the OS names one (SDL3.dll, libSDL3.so, libSDL3.dylib). -->
    <MagicNativePrefix Condition="!$([MSBuild]::IsOSPlatform('Windows'))">lib</MagicNativePrefix>
    <MagicNativeSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.dll</MagicNativeSuffix>
    <MagicNativeSuffix Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</MagicNativeSuffix>
    <MagicNativeSuffix Condition="'$(MagicNativeSuffix)' == ''">.so</MagicNativeSuffix>
  </PropertyGroup>

  <!-- Where a library comes from: a Repository at a Tag, with the Submodules it builds from, paths in the repository
       and none unless named; or the archive at Url its author publishes, verified by Sha256, with the shared library at
       Library in it. How it is built: in Release with its CMakeOptions, one CMake argument each, installed unless
       CMakeTarget names the one target to build, after the libraries it DependsOn; or, for a library with no build of
       its own, compiled from its Sources. What is bound of it: the rest, read by the bindings generator, ours unless
       Generator names Microsoft's ClangSharpPInvokeGenerator, which binds it with C's own names and leaves out the
       declarations Unbound names, those it has no C# for. -->
  <ItemDefinitionGroup>
    <NativeLibrary>
      <Repository />
      <Tag />
      <Submodules />
      <Url />
      <Sha256 />
      <Library />
      <CMakeOptions />
      <CMakeTarget />
      <DependsOn />
      <Sources />
      <Namespace>$(RootNamespace)</Namespace>
      <Headers />
      <IncludePath />
      <Defines />
      <Prefixes />
      <Class />
      <Shims />
      <Generator />
      <Unbound />
      <HeadersOnly>false</HeadersOnly>
    </NativeLibrary>
  </ItemDefinitionGroup>

  <!-- Where each library's source and product live, and what this project makes from it, known without building, so a
       design-time build sees the same items as a real one. -->
  <Target Name="_LocateNativeLibraries" Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <NativeLibrary>
        <Checkout>$(MagicNativeLibs)%(Identity)/source/</Checkout>
        <Native>$(MagicNativeLibs)%(Identity)/built/native/$(MagicNativePrefix)%(Identity)$(MagicNativeSuffix)</Native>
        <Response>$(IntermediateOutputPath)%(Identity).bindings.rsp</Response>
        <RootHeader>$(IntermediateOutputPath)%(Identity).root.h</RootHeader>
        <Generated>$(IntermediateOutputPath)%(Identity).g.cs</Generated>
        <Stamp>$(IntermediateOutputPath)%(Identity).bindings.stamp</Stamp>
      </NativeLibrary>
    </ItemGroup>
    <ItemGroup>
      <_NativeInclude Include="@(NativeLibrary)" Condition="'%(NativeLibrary.IncludePath)' != ''" />
      <_NativeGenerated Include="@(NativeLibrary)" Condition="'%(NativeLibrary.Headers)' != ''" />
      <_ClangSharpGenerated Include="@(_NativeGenerated)" Condition="'%(_NativeGenerated.Generator)' == 'ClangSharpPInvokeGenerator'" />
      <_NativeBuilt Include="@(NativeLibrary->'%(Native)')" Condition="'%(NativeLibrary.HeadersOnly)' != 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <_NativeIncludeFolders>@(_NativeInclude->'%(Checkout)%(IncludePath)', ',')</_NativeIncludeFolders>
    </PropertyGroup>
  </Target>

  <!-- Builds the project's libraries that are not built yet. Each library is had through CMake's ExternalProject: the
       build writes the project's items as one superbuild in its intermediate folder, an ExternalProject call each, and
       for a library declared by its Sources the CMake project that compiles them, beside the library. A repository is
       fetched at its tag alone, by a script written beside the library, and of its submodules only those its item
       names, each one commit deep; only what it lacks touches the network. A hash of what CMake is told of a library,
       and of the libraries it depends on, names a ready marker in its folder, so a library is built when its
       declaration changed or it is missing, and a build cut short leaves no marker; CMake's own stamps then resume it
       at the step that did not finish. When every library is ready nothing runs. The superbuild builds
       one library at a time, in the order declared, each library's own build on the cores the caller allows, below
       normal priority, so a long native build never makes the machine unusable. Each library has a named mutex, as
       several checkouts share the folder: a project holds those of all the libraries it declares, whose folders its
       superbuild writes in, and whoever comes second finds the markers, while other projects' libraries build beside
       it. Two libraries build at once on the machine, each in one of two lanes, so a second fills what the first
       leaves idle (configuring, linking and fetching are one core's work) and, on the default cores, the two take the
       machine's between them. On Windows CMake runs inside Visual Studio's developer environment, which brings its
       compiler, CMake and Ninja; elsewhere they come from the PATH. What the build is doing is logged as it happens: a
       line as each library starts and ends, and what CMake, git and the compilers print one verbosity down. -->
  <UsingTask TaskName="BuildNativeLibraries" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Libraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Natives ParameterType="System.String" Required="true" />
      <Superbuild ParameterType="System.String" Required="true" />
      <Project ParameterType="System.String" Required="true" />
      <Rid ParameterType="System.String" Required="true" />
      <Cores ParameterType="System.Int32" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Threading" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Fragment" Language="cs"><![CDATA[
string natives = Natives.Replace('\\', '/').TrimEnd('/');
string superbuild = Superbuild.Replace('\\', '/').TrimEnd('/');
bool windows = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
int cores = Cores > 0 ? Cores : Math.Max(1, Environment.ProcessorCount / 2);

// Runs a command, after the developer environment where there is one, and logs what it prints as it prints it, from
// this thread. The lines that say error come first in a failure's message, then the last ones: a compiler's error is
// rarely among the last lines.
bool Run(string environment, string file, string arguments, System.Collections.Generic.List<string> lines, string code)
{
    System.Diagnostics.ProcessStartInfo start = environment == null
        ? new System.Diagnostics.ProcessStartInfo(file, arguments)
        : new System.Diagnostics.ProcessStartInfo("cmd.exe", "/c \"" + environment + " >nul 2>&1 && " + file + " " + arguments + "\"");
    start.UseShellExecute = false;
    start.RedirectStandardOutput = true;
    start.RedirectStandardError = true;
    start.WorkingDirectory = natives;
    start.Environment["CMAKE_BUILD_PARALLEL_LEVEL"] = cores.ToString();
    if (windows)
    {
        // A library's test data can run past Windows' path limit (HarfBuzz's does), which git refuses unless told: told
        // here for every git the build runs, the submodules' included, and nowhere else.
        start.Environment["GIT_CONFIG_COUNT"] = "1";
        start.Environment["GIT_CONFIG_KEY_0"] = "core.longpaths";
        start.Environment["GIT_CONFIG_VALUE_0"] = "true";
    }
    try
    {
        using (System.Diagnostics.Process process = System.Diagnostics.Process.Start(start))
        {
            try
            {
                process.PriorityClass = System.Diagnostics.ProcessPriorityClass.BelowNormal;
            }
            catch (InvalidOperationException)
            {
            }

            System.Collections.Concurrent.ConcurrentQueue<string> received = new System.Collections.Concurrent.ConcurrentQueue<string>();
            process.OutputDataReceived += (sender, e) => { if (e.Data != null) { received.Enqueue(e.Data); } };
            process.ErrorDataReceived += (sender, e) => { if (e.Data != null) { received.Enqueue(e.Data); } };
            process.BeginOutputReadLine();
            process.BeginErrorReadLine();
            void Drain()
            {
                string line;
                while (received.TryDequeue(out line))
                {
                    lines.Add(line);
                    Log.LogMessage(MessageImportance.Normal, line);
                }
            }

            while (!process.WaitForExit(250))
            {
                Drain();
            }

            // Without a timeout, the wait also lasts until both streams are read to their end.
            process.WaitForExit();
            Drain();
            if (process.ExitCode == 0)
            {
                return true;
            }

            System.Collections.Generic.IEnumerable<string> errors = lines.Where(line => line.IndexOf("error", StringComparison.OrdinalIgnoreCase) >= 0 && line.IndexOf("warning", StringComparison.OrdinalIgnoreCase) < 0).Take(40);
            Log.LogError("", code, "", "", 0, 0, 0, 0, "{0} {1} failed:\n{2}\n...\n{3}", file, arguments, string.Join("\n", errors), string.Join("\n", lines.Skip(Math.Max(0, lines.Count - 15))));
            return false;
        }
    }
    catch (System.ComponentModel.Win32Exception)
    {
        Log.LogError("", code, "", "", 0, 0, 0, 0, "{0} was not found: building the native libraries needs git, CMake, Ninja and a C++ toolchain (README).", file);
        return false;
    }
}

// Visual Studio's developer environment for the architecture built for, found through its installer's vswhere: the
// command every CMake call runs after, which puts its compiler, CMake and Ninja on the PATH.
string DeveloperEnvironment()
{
    string vswhere = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86), "Microsoft Visual Studio", "Installer", "vswhere.exe");
    System.Collections.Generic.List<string> lines = new System.Collections.Generic.List<string>();
    if (!File.Exists(vswhere) || !Run(null, vswhere, "-latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath", lines, "BND017") || lines.Count == 0)
    {
        Log.LogError("", "BND017", "", "", 0, 0, 0, 0, "Building the native libraries needs Visual Studio with its \"Desktop development with C++\" workload (README).");
        return null;
    }

    string devCmd = Path.Combine(lines[0].Trim(), "Common7", "Tools", "VsDevCmd.bat");
    string arch = Rid.EndsWith("arm64", StringComparison.Ordinal) ? "arm64" : "x64";
    string host = RuntimeInformation.OSArchitecture == Architecture.Arm64 ? "arm64" : "x64";
    return "call \"" + devCmd + "\" -arch=" + arch + " -host_arch=" + host + " -no_logo";
}

// One CMake argument, quoted, so that a path with spaces stays one; CMake's escapes keep a backslash, quote or dollar
// sign as it was written.
string Quote(string value)
{
    return "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("$", "\\$") + "\"";
}

// A list in an item's metadata: an entry per semicolon, trimmed, so a long list can be written over several lines.
string[] Split(string value)
{
    return value.Split(';').Select(entry => entry.Trim()).Where(entry => entry.Length > 0).ToArray();
}

// A folder of a library's source, as an item names it relative to the source's root.
string Under(string folder, string relative)
{
    return relative == "." || relative.Length == 0 ? folder + "/source" : folder + "/source/" + relative.Replace('\\', '/');
}

// Writes a file only when what it holds changes, so CMake and Ninja see it change only then.
void WriteWhenChanged(string path, string text)
{
    if (!File.Exists(path) || File.ReadAllText(path) != text)
    {
        Directory.CreateDirectory(Path.GetDirectoryName(path));
        File.WriteAllText(path, text);
    }
}

// What fetches a library from its repository, written beside it in place of ExternalProject's own git download, which
// takes every branch's tip and every tag with the one asked for: the tag's commit alone, then each submodule named at
// the commit the tag pins, one commit deep. A source that holds the tag already is checked out from what it holds, with
// nothing fetched, as a superbuild new to a checkout runs every step again; one fetched from another repository is
// fetched again from nothing. A checkout cut short is finished, and a file the tag leaves as it was keeps its time.
string fetch = "# Written by the build from Directory.Build.targets: edit that, never this file. Fetches REPOSITORY at TAG into\n"
    + "# SOURCE, and of its submodules the SUBMODULES named, a comma between.\n"
    + "cmake_minimum_required(VERSION 3.28)\n"
    + "function(git)\n"
    + "  execute_process(COMMAND \"${GIT}\" -C \"${SOURCE}\" ${ARGN} COMMAND_ERROR_IS_FATAL ANY)\n"
    + "endfunction()\n"
    + "set(origin \"\")\n"
    + "if(EXISTS \"${SOURCE}/.git\")\n"
    + "  execute_process(COMMAND \"${GIT}\" -C \"${SOURCE}\" config --get remote.origin.url OUTPUT_VARIABLE origin OUTPUT_STRIP_TRAILING_WHITESPACE)\n"
    + "endif()\n"
    + "if(NOT \"${origin}\" STREQUAL \"${REPOSITORY}\")\n"
    + "  file(REMOVE_RECURSE \"${SOURCE}\")\n"
    + "  file(MAKE_DIRECTORY \"${SOURCE}\")\n"
    + "  git(init --quiet)\n"
    + "  git(remote add origin \"${REPOSITORY}\")\n"
    + "endif()\n"
    + "execute_process(COMMAND \"${GIT}\" -C \"${SOURCE}\" rev-parse --verify --quiet \"refs/tags/${TAG}^{commit}\" RESULT_VARIABLE missing OUTPUT_QUIET)\n"
    + "if(missing)\n"
    + "  git(fetch --depth 1 --no-tags origin tag \"${TAG}\")\n"
    + "endif()\n"
    + "git(-c advice.detachedHead=false checkout --force --quiet \"refs/tags/${TAG}\")\n"
    + "if(SUBMODULES)\n"
    + "  string(REPLACE \",\" \";\" SUBMODULES \"${SUBMODULES}\")\n"
    + "  git(submodule update --init --depth 1 -- ${SUBMODULES})\n"
    + "endif()\n";

// Each library as CMake is told it. A library is had from its repository at a tag, or from its author's archive; its
// own steps run with the terminal, so Ninja passes each one's output on as it comes rather than when the step ends.
int count = Libraries.Length;
string[] names = Libraries.Select(library => library.ItemSpec).ToArray();
string[] folders = names.Select(name => natives + "/" + name).ToArray();
string[] calls = new string[count];
string[] projects = new string[count];
string[] markers = new string[count];
System.Collections.Generic.Dictionary<string, string> hashes = new System.Collections.Generic.Dictionary<string, string>(StringComparer.Ordinal);
for (int i = 0; i < count; i++)
{
    ITaskItem library = Libraries[i];
    string name = names[i];
    string folder = folders[i];
    string repository = library.GetMetadata("Repository");
    string url = library.GetMetadata("Url");
    string target = library.GetMetadata("CMakeTarget");
    string[] dependsOn = Split(library.GetMetadata("DependsOn"));
    string[] sources = Split(library.GetMetadata("Sources"));
    string[] submodules = Split(library.GetMetadata("Submodules"));
    foreach (string dependency in dependsOn.Where(dependency => !hashes.ContainsKey(dependency)))
    {
        Log.LogError("", "BND018", "", "", 0, 0, 0, 0, "{0} depends on {1}, which {2} does not declare before it.", name, dependency, Project);
    }

    StringBuilder call = new StringBuilder("ExternalProject_Add(" + name + "\n");
    if (repository.Length > 0)
    {
        // Through the script beside the library, told what to fetch on its command line, which CMake records, so the
        // step runs again when the repository, tag or submodules change. The submodules have a comma between, as
        // ExternalProject splits a command's arguments at semicolons.
        call.Append("  DOWNLOAD_COMMAND \"${CMAKE_COMMAND}\" \"-DGIT=${GIT_EXECUTABLE}\" "
            + string.Join(" ", new[] { "-DREPOSITORY=" + repository, "-DTAG=" + library.GetMetadata("Tag"), "-DSUBMODULES=" + string.Join(",", submodules), "-DSOURCE=" + folder + "/source" }.Select(Quote))
            + " -P " + Quote(folder + "/fetch.cmake"));
    }
    else if (url.Length > 0)
    {
        call.Append("  URL " + Quote(url) + " URL_HASH " + Quote("SHA256=" + library.GetMetadata("Sha256")));
    }
    else
    {
        Log.LogError("", "BND019", "", "", 0, 0, 0, 0, "{0} in {1} says neither the Repository nor the Url it comes from.", name, Project);
    }

    call.Append("\n  PREFIX " + Quote(folder) + " SOURCE_DIR " + Quote(folder + "/source") + " BINARY_DIR " + Quote(folder + "/build") + " INSTALL_DIR " + Quote(folder + "/built"));
    call.Append("\n  STAMP_DIR " + Quote(folder + "/stamp") + " TMP_DIR " + Quote(folder + "/tmp") + " DOWNLOAD_DIR " + Quote(folder + "/download"));
    string arguments = string.Join(" ", new[] { "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_PREFIX=" + folder + "/built" }.Concat(Split(library.GetMetadata("CMakeOptions"))).Select(Quote));
    if (sources.Length > 0)
    {
        // A library with no build of its own: one shared library of its sources, a path relative to its source's root
        // or absolute, compiled with the defines its headers are read with and the include folders of it and of what
        // it depends on. On Windows its functions are exported without a dllexport of their own, as Linux and macOS
        // export them by default. Its project is built every time the library is, so a changed list is compiled.
        string[] includes = new[] { i }.Concat(dependsOn.Select(dependency => Array.IndexOf(names, dependency)).Where(index => index >= 0))
            .Where(index => Libraries[index].GetMetadata("IncludePath").Length > 0)
            .Select(index => Quote(Under(folders[index], Libraries[index].GetMetadata("IncludePath")))).ToArray();
        string[] defines = Split(library.GetMetadata("Defines")).Select(Quote).ToArray();
        projects[i] = "# Written by the build from " + Project + "'s " + name + " item: edit the item, never this file.\n"
            + "cmake_minimum_required(VERSION 3.28)\n"
            + "project(" + name + " C CXX)\n"
            + "add_library(" + name + " SHARED " + string.Join(" ", sources.Select(source => Quote(Path.IsPathRooted(source) ? source.Replace('\\', '/') : Under(folder, source)))) + ")\n"
            + (includes.Length > 0 ? "target_include_directories(" + name + " PRIVATE " + string.Join(" ", includes) + ")\n" : "")
            + (defines.Length > 0 ? "target_compile_definitions(" + name + " PRIVATE " + string.Join(" ", defines) + ")\n" : "")
            + "set_target_properties(" + name + " PROPERTIES CXX_STANDARD 17 WINDOWS_EXPORT_ALL_SYMBOLS ON)\n";
        call.Append("\n  CONFIGURE_COMMAND \"${CMAKE_COMMAND}\" -G \"${CMAKE_GENERATOR}\" -S " + Quote(folder + "/project") + " -B <BINARY_DIR> " + arguments);
        call.Append("\n  BUILD_COMMAND \"${CMAKE_COMMAND}\" --build <BINARY_DIR> --target " + name + " INSTALL_COMMAND \"\" BUILD_ALWAYS ON");
    }
    else if (url.Length > 0 || library.GetMetadata("HeadersOnly") == "true")
    {
        call.Append("\n  CONFIGURE_COMMAND \"\" BUILD_COMMAND \"\" INSTALL_COMMAND \"\"");
    }
    else
    {
        call.Append("\n  CMAKE_ARGS " + arguments);
        if (target.Length > 0)
        {
            call.Append("\n  BUILD_COMMAND \"${CMAKE_COMMAND}\" --build <BINARY_DIR> --target " + target + " INSTALL_COMMAND \"\"");
        }
    }

    call.Append("\n  USES_TERMINAL_DOWNLOAD ON USES_TERMINAL_UPDATE ON USES_TERMINAL_PATCH ON USES_TERMINAL_CONFIGURE ON USES_TERMINAL_BUILD ON USES_TERMINAL_INSTALL ON");
    if (dependsOn.Length > 0)
    {
        call.Append("\n  DEPENDS " + string.Join(" ", dependsOn));
    }

    calls[i] = call.Append(")\n").ToString();
    using (System.Security.Cryptography.SHA256 sha256 = System.Security.Cryptography.SHA256.Create())
    {
        byte[] made = Encoding.UTF8.GetBytes(calls[i] + projects[i] + string.Concat(dependsOn.Where(hashes.ContainsKey).Select(dependency => hashes[dependency])));
        hashes[name] = BitConverter.ToString(sha256.ComputeHash(made)).Replace("-", "").Substring(0, 16);
    }

    markers[i] = folder + "/ready." + hashes[name];
}

if (Log.HasLoggedErrors)
{
    return false;
}

// The library's one shared library, taken to built/native/, where the project's build copies it from: at Library in
// what was downloaded, else found by name in what was installed, then in CMake's working folder (a target built
// alone). It is read through its name, so where Linux and macOS install the name as a link to the versioned file, what
// is copied is the file. A working folder can be gone, as CI drops them before caching, and then nothing was rebuilt
// and what was taken last time stands.
bool Take(int i)
{
    string native = Libraries[i].GetMetadata("Native");
    string file = Path.GetFileName(native);
    string library = Libraries[i].GetMetadata("Library");
    string found = library.Length > 0
        ? folders[i] + "/source/" + library
        : new[] { "/built", "/build" }.Select(sub => folders[i] + sub).Where(Directory.Exists)
            .SelectMany(folder => Directory.GetFiles(folder, file, SearchOption.AllDirectories))
            .FirstOrDefault(candidate => !Path.GetDirectoryName(candidate).Replace('\\', '/').EndsWith("/built/native", StringComparison.Ordinal));
    if (found == null || !File.Exists(found))
    {
        if (library.Length == 0 && File.Exists(native))
        {
            return true;
        }

        Log.LogError("", "BND016", "", "", 0, 0, 0, 0, "{0} built, but there is no {1} in {2}: the item's name, CMakeTarget or Library does not name the library it makes.", names[i], library.Length > 0 ? library : file, folders[i]);
        return false;
    }

    Directory.CreateDirectory(Path.GetDirectoryName(native));
    using (FileStream from = File.OpenRead(found))
    using (FileStream to = File.Create(native))
    {
        from.CopyTo(to);
    }

    return true;
}

// A library's mutex, held while its folder is written; one a build that died held is taken as it is, as CMake's stamps
// resume what it was doing.
Mutex Hold(string name)
{
    Mutex mutex = new Mutex(false, "Magic.Natives." + name);
    try
    {
        if (!mutex.WaitOne(0))
        {
            Log.LogMessage(MessageImportance.High, "{0} is waiting for another build of {1} on this machine to finish.", Project, name);
            mutex.WaitOne();
        }
    }
    catch (AbandonedMutexException)
    {
    }

    return mutex;
}

// One of the machine's two lanes. Polled, as a wait on several named mutexes at once is Windows' alone.
Mutex Lane()
{
    bool told = false;
    while (true)
    {
        for (int lane = 0; lane < 2; lane++)
        {
            Mutex mutex = new Mutex(false, "Magic.Natives.Lane" + lane);
            try
            {
                if (mutex.WaitOne(0))
                {
                    return mutex;
                }
            }
            catch (AbandonedMutexException)
            {
                return mutex;
            }

            mutex.Dispose();
        }

        if (!told)
        {
            Log.LogMessage(MessageImportance.High, "{0} is waiting for one of the two native libraries building on this machine to finish.", Project);
            told = true;
        }

        Thread.Sleep(1000);
    }
}

Func<int, bool> ready = i => File.Exists(markers[i]) && (Libraries[i].GetMetadata("HeadersOnly") == "true" || File.Exists(Libraries[i].GetMetadata("Native")));
if (!Enumerable.Range(0, count).All(ready))
{
    // Yielding while it waits and builds: the node builds other projects meanwhile, as a project waiting on a
    // reference resumes only on the node it started on.
    BuildEngine3.Yield();
    Mutex[] held = Array.Empty<Mutex>();
    try
    {
        // In name order, so two builds never each hold a mutex the other waits for.
        held = names.OrderBy(name => name, StringComparer.Ordinal).Select(Hold).ToArray();

        int[] pending = Enumerable.Range(0, count).Where(i => !ready(i)).ToArray();
        // Every command runs in the shared folder.
        Directory.CreateDirectory(natives);
        string environment = pending.Length > 0 && windows ? DeveloperEnvironment() : null;
        if (pending.Length > 0 && (!windows || environment != null))
        {
            Log.LogMessage(MessageImportance.High, "Building {0}'s native libraries under {1}/, each once per machine and again when its item changes: {2}.", Project, natives, string.Join(", ", pending.Select(i => names[i])));
            for (int i = 0; i < count; i++)
            {
                if (projects[i] != null)
                {
                    WriteWhenChanged(folders[i] + "/project/CMakeLists.txt", projects[i]);
                }

                if (Libraries[i].GetMetadata("Repository").Length > 0)
                {
                    WriteWhenChanged(folders[i] + "/fetch.cmake", fetch);
                }
            }

            WriteWhenChanged(superbuild + "/CMakeLists.txt",
                "# Written by the build from " + Project + "'s NativeLibrary items: edit those, never this file. Each library is an\n"
                + "# ExternalProject, built into its folder under the one every checkout on the machine shares.\n"
                + "cmake_minimum_required(VERSION 3.28)\n"
                + "project(MagicNatives NONE)\n"
                + "include(ExternalProject)\n"
                + "find_package(Git REQUIRED)\n\n"
                + string.Join("\n", calls));
            System.Collections.Generic.List<string> lines = new System.Collections.Generic.List<string>();
            bool built = Run(environment, "cmake", "-S \"" + superbuild + "\" -B \"" + superbuild + "/build\" -G Ninja", lines, "BND015");
            for (int step = 0; built && step < pending.Length; step++)
            {
                int i = pending[step];
                ITaskItem library = Libraries[i];
                using (Mutex lane = Lane())
                {
                    try
                    {
                        string from = library.GetMetadata("Repository").Length > 0 ? library.GetMetadata("Tag") + " from " + library.GetMetadata("Repository") : library.GetMetadata("Url");
                        Log.LogMessage(MessageImportance.High, "{0} ({1} of {2}): {3}", names[i], step + 1, pending.Length, from);
                        System.Diagnostics.Stopwatch watch = System.Diagnostics.Stopwatch.StartNew();
                        lines.Clear();
                        built = Run(environment, "cmake", "--build \"" + superbuild + "/build\" --target " + names[i] + " --parallel 1", lines, "BND015")
                            && (library.GetMetadata("HeadersOnly") == "true" || Take(i));
                        if (built)
                        {
                            foreach (string old in Directory.GetFiles(folders[i], "ready.*"))
                            {
                                File.Delete(old);
                            }

                            File.WriteAllText(markers[i], "");
                            // Formatted here: a message's arguments reach the logger as text, their format lost on the way.
                            Log.LogMessage(MessageImportance.High, "{0}: ready in {1} s", names[i], Math.Round(watch.Elapsed.TotalSeconds).ToString("0"));
                        }
                    }
                    finally
                    {
                        lane.ReleaseMutex();
                    }
                }
            }
        }
    }
    finally
    {
        foreach (Mutex mutex in held)
        {
            mutex.ReleaseMutex();
            mutex.Dispose();
        }

        BuildEngine3.Reacquire();
    }
}

// What a fragment returns is Success, true unless set, not whether it logged an error. A library that failed fails the
// task, so its target stamps nothing as prepared and no bindings are generated from headers that are not there.
Success = !Log.HasLoggedErrors;
]]></Code>
    </Task>
  </UsingTask>

  <!-- What the native build reads beyond the project's files: the items as they came out, which a property from the
       command line or the environment can change with no file changing. -->
  <Target Name="_DeclareNativeLibraries" DependsOnTargets="_LocateNativeLibraries" Condition="'@(NativeLibrary)' != '' and '$(DesignTimeBuild)' != 'true'">
    <WriteLinesToFile File="$(MagicNativeSuperbuild)declared.txt" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="@(NativeLibrary->'%(Identity)|%(Repository)|%(Tag)|%(Submodules)|%(Url)|%(Sha256)|%(Library)|%(CMakeOptions)|%(CMakeTarget)|%(DependsOn)|%(Sources)|%(IncludePath)|%(Defines)|%(HeadersOnly)|%(Native)')" />
  </Target>

  <!-- Before the project's references, so a cold native build goes on while Core compiles. Skipped while nothing it
       reads has changed since it last finished: the project's files, the items, and the libraries' binaries in the
       shared folder, which another checkout's build of a library rewrites. So a build that finds every library ready
       starts no task, whose compiling is most of what such a run costs; the task, when it runs, decides what to build. -->
  <Target Name="PrepareNativeLibraries" DependsOnTargets="_DeclareNativeLibraries" BeforeTargets="ResolveProjectReferences"
          Condition="'@(NativeLibrary)' != '' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildAllProjects);$(MagicNativeSuperbuild)declared.txt;@(_NativeBuilt)" Outputs="$(MagicNativeSuperbuild)prepared.stamp">
    <BuildNativeLibraries Libraries="@(NativeLibrary)" Natives="$(MagicNativeLibs)" Superbuild="$(MagicNativeSuperbuild)"
                          Project="$(MSBuildProjectName)" Rid="$(MagicNativeRid)" Cores="$(MagicNativeCores)" />
    <Touch Files="$(MagicNativeSuperbuild)prepared.stamp" AlwaysCreate="true" />
  </Target>

  <!-- Microsoft's generator, for each item that names it, gets the arguments this writes: the item's headers read as
       one parse, through a root header including each of them, as ours reads them; what is declared under its include
       folder bound, as what it includes from elsewhere is another library's; and the rest the same for every item:
       C's bool as bool and char as byte, as our generator writes them, the target every platform shares, the
       generator's own attributes beside the API, and a header that marks the file generated. One item at a time, so
       each is written with its own headers. -->
  <Target Name="_WriteClangSharpArguments" Outputs="%(_ClangSharpGenerated.Identity)" Condition="'@(_ClangSharpGenerated)' != ''">
    <ItemGroup>
      <_ClangSharpHeader Remove="@(_ClangSharpHeader)" />
      <_ClangSharpHeader Include="%(_ClangSharpGenerated.Headers)" Checkout="%(_ClangSharpGenerated.Checkout)" />
      <_ClangSharpTraversed Remove="@(_ClangSharpTraversed)" />
      <_ClangSharpTraversed Include="%(_ClangSharpGenerated.Checkout)%(_ClangSharpGenerated.IncludePath)/**/*.h" />
      <_ClangSharpDefine Remove="@(_ClangSharpDefine)" />
      <_ClangSharpDefine Include="%(_ClangSharpGenerated.Defines)" />
      <_ClangSharpUnbound Remove="@(_ClangSharpUnbound)" />
      <_ClangSharpUnbound Include="%(_ClangSharpGenerated.Unbound)" />
    </ItemGroup>
    <WriteLinesToFile File="%(_ClangSharpGenerated.RootHeader)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="@(_ClangSharpHeader->'#include &quot;%(Checkout)%(Identity)&quot;')" />
    <WriteLinesToFile File="%(_ClangSharpGenerated.Response)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="--language=c;--file=%(_ClangSharpGenerated.RootHeader);@(_ClangSharpTraversed->'--traverse=%(FullPath)');@(_NativeInclude->'--include-directory=%(Checkout)%(IncludePath)');@(_ClangSharpDefine->'--define-macro=%(Identity)');@(_ClangSharpUnbound->'--exclude=%(Identity)');--namespace=%(_ClangSharpGenerated.Namespace);--library-path=%(_ClangSharpGenerated.Identity);--method-class-name=%(_ClangSharpGenerated.Class);--output=%(_ClangSharpGenerated.Generated);--header-file=$(IntermediateOutputPath)bindings.header;--config=codegen=latest;--config=types=windows;--generate=macro-bindings;--generate=funcs-with-body=false;--generate=helper-types;--remap=_Bool=bool;--remap=char=byte;--no-resource-directory-detection;--additional=-nostdinc;--additional=-isystem$(MagicNativeSysroot);--additional=--target=$(MagicNativeBindingsTarget)" />
  </Target>

  <!-- The generated API joins the compile, and the libraries join the output, before the build assigns output paths,
       so a project referencing this one copies them too. Located first, as a design-time build skips the preparing
       and what it depends on; Microsoft's generator's arguments after the preparing, which fetches the headers they
       list. -->
  <Target Name="_AddNativeLibraryItems" DependsOnTargets="_LocateNativeLibraries;PrepareNativeLibraries;_WriteClangSharpArguments" BeforeTargets="AssignTargetPaths;CoreCompile" Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <None Include="@(_NativeBuilt)" Link="runtimes/$(MagicNativeRid)/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <Compile Include="@(_NativeGenerated->'%(Generated)');$(IntermediateOutputPath)NativeLibraries.g.cs" Visible="false" />
      <FileWrites Include="@(_NativeGenerated->'%(Generated)');@(_NativeGenerated->'%(Response)');$(IntermediateOutputPath)NativeLibraries.g.cs" />
      <FileWrites Include="@(_NativeGenerated->'%(Stamp)');@(_NativeGenerated->'$(IntermediateOutputPath)%(Identity).g.skipped.txt');@(_NativeGenerated->'$(IntermediateOutputPath)%(Identity).g.names.txt')" />
      <FileWrites Include="@(_ClangSharpGenerated->'%(RootHeader)');$(IntermediateOutputPath)bindings.header" Condition="'@(_ClangSharpGenerated)' != ''" />
      <FileWrites Include="$(MagicNativeSuperbuild)declared.txt;$(MagicNativeSuperbuild)prepared.stamp" />
    </ItemGroup>
    <!-- A generated file gone with its stamp left (deleted by hand) is generated again rather than missed. -->
    <Delete Files="%(_NativeGenerated.Stamp)" Condition="!Exists('%(_NativeGenerated.Generated)')" />
    <!-- Nothing crosses to C marshalled: every call is blittable (a C bool is one byte), so each is a direct call. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeLibraries.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;[assembly: System.Runtime.CompilerServices.DisableRuntimeMarshalling]" />
    <!-- What Microsoft's generator puts at the top of its file, as ours does: the file is generated, and its code is
         checked by nothing. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)bindings.header" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;#pragma warning disable" Condition="'@(_ClangSharpGenerated)' != ''" />
    <WriteLinesToFile File="%(_NativeGenerated.Response)" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'%(_NativeGenerated.Generator)' == ''"
                      Lines="--library=%(_NativeGenerated.Identity);--namespace=%(_NativeGenerated.Namespace);--root=%(_NativeGenerated.Checkout);--headers=$([System.String]::Copy('%(_NativeGenerated.Headers)').Replace(';', ','));--include=$([System.String]::Copy('%(_NativeGenerated.IncludePath)').Replace(';', ','));--include-absolute=$(_NativeIncludeFolders);--defines=$([System.String]::Copy('%(_NativeGenerated.Defines)').Replace(';', ','));--prefixes=$([System.String]::Copy('%(_NativeGenerated.Prefixes)').Replace(';', ','));--class=%(_NativeGenerated.Class);--shims=$([System.String]::Copy('%(_NativeGenerated.Shims)').Replace(';', ','));--sysroot=$(MagicNativeSysroot);--output=%(_NativeGenerated.Generated)" />
  </Target>

  <!-- The generator, a reference only for the order it builds in: restored with everything else and built once per
       build, in the same configuration, so it lands with what it builds for, and only where a library is declared.
       Nothing of it is compiled against or copied. Microsoft's, a native tool, is downloaded by the same restore,
       its package for this machine's runtime, and run where NuGet keeps it. -->
  <ItemGroup Condition="'@(NativeLibrary)' != ''">
    <ProjectReference Include="$(MagicNativeBindingsGenerator)" ReferenceOutputAssembly="false" Private="false" />
    <PackageDownload Include="ClangSharpPInvokeGenerator.$(MagicClangSharpRid)" Version="[$(ClangSharpPInvokeGeneratorVersion)]" />
  </ItemGroup>

  <!-- Generation reruns when a library's binary changed (a new pin brings new headers with it), the item changed or a
       generator did, and the stamp records the run. Ours rewrites only a file whose text changed, so the project
       compiles again only when the API did; Microsoft's rewrites its file whenever it runs, which is only then. -->
  <Target Name="GenerateNativeBindings" DependsOnTargets="_AddNativeLibraryItems" BeforeTargets="CoreCompile" Condition="'@(NativeLibrary)' != '' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(_NativeBuilt);@(_NativeGenerated->'%(Response)');@(_ClangSharpGenerated->'%(RootHeader)');$(MagicNativeBindingsGeneratorDll);@(_ClangSharpGenerated->'$(MagicClangSharpGenerator)')"
          Outputs="@(_NativeGenerated->'%(Stamp)')">
    <!-- Yielding: the node builds other projects while the generator runs, as a project waiting on a reference resumes
         only on the node it started on. -->
    <Exec Command="dotnet &quot;$(MagicNativeBindingsGeneratorDll)&quot; @&quot;%(_NativeGenerated.Response)&quot;"
          Condition="'%(_NativeGenerated.Generator)' == ''" YieldDuringToolExecution="true" />
    <!-- It exits non-zero on any warning, each a declaration it could not bind faithfully, so one fails the build
         until the item lists it as Unbound. -->
    <Exec Command="&quot;$(MagicClangSharpGenerator)&quot; @&quot;%(_NativeGenerated.Response)&quot;"
          Condition="'%(_NativeGenerated.Generator)' == 'ClangSharpPInvokeGenerator'" YieldDuringToolExecution="true" />
    <Touch Files="@(_NativeGenerated->'%(Stamp)')" AlwaysCreate="true" />
  </Target>
</Project>

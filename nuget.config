<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only, whatever sources the machine has configured. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- Visual Studio restores a project as it loads or changes, once every project it is loading is ready, so a build
       does not restore again: the restore a build starts waits for that only the first time, and after a reload fails
       on a project still loading ("details for project ... could not be loaded"). dotnet reads neither key and restores
       as it always does. -->
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="False" />
  </packageRestore>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Magic: the executable that loads and launches a project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Magic</AssemblyName>
    <!-- Magic's version; CI adds the run's number as the patch. -->
    <VersionPrefix>0.1</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CommandLine/Magic.CommandLine.csproj" />
    <ProjectReference Include="../Debugging/Magic.Debugging.csproj" />
    <ProjectReference Include="../GemAPI/Magic.GemAPI.csproj" />
    <ProjectReference Include="../Host/Magic.Host.csproj" />
  </ItemGroup>
</Project>

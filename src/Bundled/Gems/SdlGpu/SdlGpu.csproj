<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The GPU, through SDL GPU: provides IGpu on Vulkan, Direct3D 12 or Metal.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SDL is a C API: its device, command buffers and passes are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL's C APIs, generated by the SdlBindings gem, which carries SDL for this machine. -->
    <ProjectReference Include="../SdlBindings/SdlBindings.csproj" />
    <!-- SDL's API, generated by the build. The SDL that runs is the copy the platform gem loaded, which owns the window
         this gem draws into and which every gem shares (GemLoadContext). -->
  </ItemGroup>
</Project>

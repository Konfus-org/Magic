<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Audio files to samples, through SDL_mixer: provides the Audio asset loader.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SDL_mixer is a C API: its decoders and streams are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL's C APIs, generated by the SdlBindings gem, which carries SDL and SDL_mixer for this machine. -->
    <ProjectReference Include="../SdlBindings/SdlBindings.csproj" />
  </ItemGroup>
</Project>

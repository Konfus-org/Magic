<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Each model's clusters and cards, made as it loads: provides the Model post-processor.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A generated C API is pointers and fixed buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- XxHash3: the handles of a model's card atlases, the same on every run. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <!-- meshoptimizer as a shared library, its stable API alone: clusters, their grouping and their simplification. The
       simplifier's option and vertex bits get owners of their own, as C tells meshopt_SimplifyPrune, a bit, from
       meshopt_simplifyPrune, a function, by case alone. -->
  <ItemGroup>
    <NativeLibrary Include="meshoptimizer" Repository="https://github.com/zeux/meshoptimizer" Tag="v1.3"
                   CMakeOptions="-DMESHOPT_BUILD_SHARED_LIBS=ON;-DMESHOPT_STABLE_EXPORTS=ON"
                   CMakeTarget="meshoptimizer" Headers="src/meshoptimizer.h" IncludePath="src"
                   Prefixes="meshopt_SimplifyVertex_=SimplifyVertex;meshopt_Simplify=SimplifyOptions;meshopt_=Meshopt"
                   Class="Meshopt" />
  </ItemGroup>
</Project>

<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Each model's clusters and cards, made as it loads: provides the Model post-processor.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- XxHash3: the handles of a model's card atlases, the same on every run. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
</Project>

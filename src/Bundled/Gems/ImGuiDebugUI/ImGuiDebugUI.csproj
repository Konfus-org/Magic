<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The debug UI, drawn with Dear ImGui: provides IDebugUI.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dear ImGui is a C API: its context, draw lists, fonts and textures are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Dear ImGui through the C API dear_bindings makes of its headers (natives/CMakeLists.txt): the public API and
       the internal one, in their own files, which lie in dear_bindings' own checkout. ImGui's folder is on the include
       path for the imconfig.h the generated header includes; the defines are the ones the library is compiled with. -->
  <ItemGroup>
    <NativeLibrary Include="imgui" IncludePath="." HeadersOnly="true" />
    <NativeLibrary Include="dcimgui" Headers="dcimgui.h;dcimgui_internal.h" IncludePath="."
                   Defines="IMGUI_USE_WCHAR32;IMGUI_DISABLE_OBSOLETE_FUNCTIONS=1"
                   Prefixes="IMGUI=ImGui;cImFontAtlas=ImFontAtlas" Class="ImGui" />
  </ItemGroup>
</Project>

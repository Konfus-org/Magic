<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The debug UI, drawn with Dear ImGui: provides IDebugUI.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dear ImGui is a C API: its context, draw lists, fonts and textures are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Dear ImGui, from its own repository, through the C API that dear_bindings, the Dear ImGui team's generator, makes
       of its headers at build time: the public API and the internal one, in their own files, built with ImGui into one
       library by the CMake file under Native/, since dear_bindings ships none. ImGui's folder is on the include path
       for the imconfig.h the generated header includes; the defines are the library's compile definitions. -->
  <ItemGroup>
    <NativeLibrary Include="imgui" Repository="https://github.com/ocornut/imgui" Commit="v1.92.9b-docking" IncludePath="." />
    <NativeLibrary Include="dcimgui" Repository="https://github.com/dearimgui/dear_bindings" Commit="v0.24"
                   Prepare="{python} {checkout}/dear_bindings.py -o {checkout}/dcimgui {checkout:imgui}/imgui.h &amp;&amp; {python} {checkout}/dear_bindings.py -o {checkout}/dcimgui_internal --include {checkout:imgui}/imgui.h {checkout:imgui}/imgui_internal.h"
                   Headers="dcimgui.h;dcimgui_internal.h" IncludePath="."
                   Defines="IMGUI_USE_WCHAR32;IMGUI_DISABLE_OBSOLETE_FUNCTIONS=1"
                   Prefixes="IMGUI=ImGui;cImFontAtlas=ImFontAtlas" Class="ImGui"
                   Source="$(MSBuildProjectDirectory)/Native" Cmake="-DIMGUI_DIR={checkout:imgui} -DGENERATED_DIR={checkout}" />
  </ItemGroup>
</Project>

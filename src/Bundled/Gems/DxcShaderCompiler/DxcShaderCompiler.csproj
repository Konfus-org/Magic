<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>HLSL to SPIR-V, DXIL or Metal, through DirectXShaderCompiler and SPIRV-Cross: provides IShaderCompiler.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- DXC and SPIRV-Cross are C APIs: sources, results and DXC's COM interfaces are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DxcTag>v1.9.2609</DxcTag>
  </PropertyGroup>

  <!-- DirectXShaderCompiler: Microsoft's own build of the tag where it publishes one, since the library is an LLVM and
       the one build that takes long; built from source where it does not (macOS, and Linux on ARM), with Microsoft's
       predefined parameters, SPIR-V code generation and no tests, so without the test framework among its submodules.
       DXC is a COM API, bound by hand in the gem, so only the compiler's library is declared, and it validates and
       signs DXIL itself. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeLibrary Include="dxcompiler" Url="https://github.com/microsoft/DirectXShaderCompiler/releases/download/$(DxcTag)/dxc_2026_09_29.zip"
                   Sha256="ad31b1fc8443175d204f77a611fdb3ef2ec42759bdc2f1167368de24a4a7e7f1" Library="bin/$(MagicNativeRid.Replace('win-', ''))/dxcompiler.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(MagicNativeRid)' == 'linux-x64'">
    <NativeLibrary Include="dxcompiler" Url="https://github.com/microsoft/DirectXShaderCompiler/releases/download/$(DxcTag)/linux_dxc_2026_09_28.x86_x64.tar.gz"
                   Sha256="96faadc7f5c282d2ffda49804beb4c3ee38127bc252b723234e3c5cdf7aa39a1" Library="lib/libdxcompiler.so" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(MagicNativeRid)' != 'linux-x64'">
    <NativeLibrary Include="dxcompiler" Repository="https://github.com/microsoft/DirectXShaderCompiler" Tag="$(DxcTag)" CMakeTarget="dxcompiler"
                   Submodules="external/DirectX-Headers;external/SPIRV-Headers;external/SPIRV-Tools"
                   CMakeOptions="-C;&lt;SOURCE_DIR&gt;/cmake/caches/PredefinedParams.cmake;-DHLSL_INCLUDE_TESTS=OFF;-DSPIRV_BUILD_TESTS=OFF;
                                 -DLLVM_INCLUDE_TESTS=OFF;-DCLANG_INCLUDE_TESTS=OFF;-DLLVM_ENABLE_ASSERTIONS=OFF;-DHLSL_BUILD_DXILCONV=OFF;-DLLVM_APPEND_VC_REV=OFF" />
  </ItemGroup>

  <!-- SPIRV-Cross's C API as a shared library, generated, for the Metal shaders the gem translates. -->
  <ItemGroup>
    <NativeLibrary Include="spirv-cross-c-shared" Repository="https://github.com/KhronosGroup/SPIRV-Cross" Tag="vulkan-sdk-1.4.363.0"
                   CMakeOptions="-DSPIRV_CROSS_SHARED=ON;-DSPIRV_CROSS_STATIC=OFF;-DSPIRV_CROSS_CLI=OFF;-DSPIRV_CROSS_ENABLE_TESTS=OFF"
                   Headers="spirv_cross_c.h" IncludePath="." Prefixes="spvc=Spvc;SPVC=Spvc;Spv=Spv;SPV=Spv" Class="Spvc" />
    <!-- XxHash3: what names a compiled shader in the cache, and the version of its source. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
</Project>

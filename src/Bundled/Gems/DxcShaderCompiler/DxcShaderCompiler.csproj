<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>HLSL to SPIR-V, DXIL or Metal, through DirectXShaderCompiler and SPIRV-Cross: provides IShaderCompiler.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- DXC and SPIRV-Cross are C APIs: sources, results and DXC's COM interfaces are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- DXC is a COM API, bound by hand in the gem, so its library alone is declared; SPIRV-Cross's C API is generated. -->
  <ItemGroup>
    <NativeLibrary Include="dxcompiler" />
    <NativeLibrary Include="spirv-cross-c-shared" Headers="spirv_cross_c.h" IncludePath="." Prefixes="spvc=Spvc;SPVC=Spvc;Spv=Spv;SPV=Spv" Class="Spvc" />
    <!-- XxHash3: what names a compiled shader in the cache, and the version of its source. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
</Project>

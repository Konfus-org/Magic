<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Spatial audio through Steam Audio: plays every Sound, heard from the player and traced through what is solid.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Steam Audio's C API: its objects are handles, its audio buffers pointers to channels. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL's C APIs, generated by the SdlBindings gem, which carries SDL for this machine: the audio device and the
         streams that convert each sound to it. -->
    <ProjectReference Include="../SdlBindings/SdlBindings.csproj" />
  </ItemGroup>

  <!-- Steam Audio as Valve builds it for every release, with Embree tracing and Intel's vector library in it: the SDK's
       headers, and its shared library for this platform. A build from source here could have neither, and needs
       dependencies its own build finds only inside its own tree. -->
  <PropertyGroup>
    <SteamAudioPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows-x64</SteamAudioPlatform>
    <SteamAudioPlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</SteamAudioPlatform>
    <SteamAudioPlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</SteamAudioPlatform>
  </PropertyGroup>
  <ItemGroup>
    <NativeLibrary Include="phonon" Url="https://github.com/ValveSoftware/steam-audio/releases/download/v4.8.1/steamaudio_4.8.1.zip"
                   Sha256="4a0aa5ec1176f38f0b0993a37c2259d9e86f27e22d5e24f83ec4c3cb9a1d5449"
                   Library="lib/$(SteamAudioPlatform)/$(MagicNativePrefix)phonon$(MagicNativeSuffix)"
                   Headers="include/phonon.h" IncludePath="include"
                   Prefixes="ipl=IPL;IPL=IPL;STEAMAUDIO=IPL" Class="IPL" />
  </ItemGroup>
</Project>

<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The GPU, through Vulkan: provides IGpu.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Vulkan is a C API: its objects are handles, and its calls take pointers to structs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vulkan's C API, generated from Khronos' registry and kept current with it, over the system's Vulkan loader
         (CODESTANDARDS: Dependencies). -->
    <PackageReference Include="Vortice.Vulkan" />
    <!-- SDL's C API, generated by the SdlBindings gem: the windows are the platform gem's, and SDL makes their
         surfaces. -->
    <ProjectReference Include="../SdlBindings/SdlBindings.csproj" />
  </ItemGroup>
</Project>

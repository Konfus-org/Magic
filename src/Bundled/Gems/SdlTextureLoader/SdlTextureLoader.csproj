<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Images to textures, through SDL_image: provides the Texture asset loader.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SDL_image is a C API: its streams and surfaces are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL's C APIs, generated by the SdlBindings gem, which carries SDL for this machine. -->
    <ProjectReference Include="../SdlBindings/SdlBindings.csproj" />
    <!-- SDL_image's API, and SDL's beneath it, generated by the build with the libraries for each OS; the gem's load
         context picks the machine's. -->
  </ItemGroup>
</Project>

// How this renderer binds a surface written against Core's Include/Surface.hlsli: composed ahead of the surface, it
// declares the draw's constants, the tables the surface's generated LoadMaterialParams reads, and how a texture is read
// (Textures.hlsli).

#ifndef MAGIC_RENDERING_SURFACES_HLSLI
#define MAGIC_RENDERING_SURFACES_HLSLI

#include "Rendering/Include/Materials.hlsli"
#include "Rendering/Include/Tables.hlsli"
#include "Rendering/Include/Textures.hlsli"

#endif

<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Models to meshes, through Assimp: provides the Model asset loader.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A file is handed to Assimp where it lies in memory, as a pointer, and its scene is walked where Assimp made it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Assimp's C API, built here from its repository: the importers of the formats Model lists, no exporters, tools
       or tests, its own zlib, and the library named plainly rather than by compiler. Its config.h, which the build
       generates, is made from the template with every option off. -->
  <ItemGroup>
    <NativeLibrary Include="assimp" Repository="https://github.com/assimp/assimp" Commit="v6.0.5"
                   Headers="include/assimp/cimport.h;include/assimp/scene.h;include/assimp/postprocess.h;assimp/config.h"
                   IncludePath="include" Shims="assimp/config.h=include/assimp/config.h.in"
                   Prefixes="ai=Assimp;AI=Assimp;ASSIMP=Assimp" Class="Assimp" CmakeTarget="assimp"
                   Cmake="-DASSIMP_BUILD_TESTS=OFF -DASSIMP_BUILD_ASSIMP_TOOLS=OFF -DASSIMP_INSTALL=OFF -DASSIMP_BUILD_ZLIB=ON -DASSIMP_WARNINGS_AS_ERRORS=OFF -DASSIMP_INJECT_DEBUG_POSTFIX=OFF -DLIBRARY_SUFFIX= -DASSIMP_NO_EXPORT=ON -DASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT=OFF -DASSIMP_BUILD_FBX_IMPORTER=ON -DASSIMP_BUILD_GLTF_IMPORTER=ON -DASSIMP_BUILD_OBJ_IMPORTER=ON" />
  </ItemGroup>
</Project>

<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Models to meshes, through Assimp: provides the Model asset loader.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A file is handed to Assimp where it lies in memory, as a pointer, and its scene is walked where Assimp made it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Assimp builds its own zlib, so the library stands alone, except on macOS, where it links the OS's: the bundled
       copy's zutil.h defines fdopen away on Apple platforms, which breaks the declaration in the current SDK's stdio.h. -->
  <PropertyGroup>
    <AssimpOwnZlib>ON</AssimpOwnZlib>
    <AssimpOwnZlib Condition="$([MSBuild]::IsOSPlatform('OSX'))">OFF</AssimpOwnZlib>
  </PropertyGroup>

  <!-- Assimp's C API: the importers of the formats Model lists, no exporters, tools or tests, the library named plainly
       rather than by compiler. Its config.h, which the library's build generates, is read made from the template with
       every option off. -->
  <ItemGroup>
    <NativeLibrary Include="assimp" Repository="https://github.com/assimp/assimp" Tag="v6.0.5" CMakeTarget="assimp"
                   CMakeOptions="-DASSIMP_BUILD_TESTS=OFF;-DASSIMP_BUILD_ASSIMP_TOOLS=OFF;-DASSIMP_INSTALL=OFF;-DASSIMP_BUILD_ZLIB=$(AssimpOwnZlib);
                                 -DASSIMP_WARNINGS_AS_ERRORS=OFF;-DASSIMP_INJECT_DEBUG_POSTFIX=OFF;-DLIBRARY_SUFFIX=;-DASSIMP_NO_EXPORT=ON;
                                 -DASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT=OFF;-DASSIMP_BUILD_FBX_IMPORTER=ON;-DASSIMP_BUILD_GLTF_IMPORTER=ON;-DASSIMP_BUILD_OBJ_IMPORTER=ON"
                   Headers="include/assimp/cimport.h;include/assimp/scene.h;include/assimp/postprocess.h;assimp/config.h"
                   IncludePath="include" Shims="assimp/config.h=include/assimp/config.h.in"
                   Prefixes="ai=Assimp;AI=Assimp;ASSIMP=Assimp" Class="Assimp" />
  </ItemGroup>
</Project>

<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Models to meshes, through Assimp: provides the Model asset loader.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A file is handed to Assimp where it lies in memory, as a pointer, and its scene is walked where Assimp made it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Assimp's C API. Its config.h, which the library's build generates, is read made from the template with every
       option off. -->
  <ItemGroup>
    <NativeLibrary Include="assimp" Headers="include/assimp/cimport.h;include/assimp/scene.h;include/assimp/postprocess.h;assimp/config.h"
                   IncludePath="include" Shims="assimp/config.h=include/assimp/config.h.in"
                   Prefixes="ai=Assimp;AI=Assimp;ASSIMP=Assimp" Class="Assimp" />
  </ItemGroup>
</Project>

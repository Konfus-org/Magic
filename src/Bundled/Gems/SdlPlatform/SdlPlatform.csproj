<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The window and input, through SDL3: provides IWindow and IInput.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SDL is a C API: its windows, gamepads and events are pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL's C APIs, generated by the SdlBindings gem, which carries SDL for this machine. -->
    <ProjectReference Include="../SdlBindings/SdlBindings.csproj" />
    <!-- SDL's API and the library for each OS, generated by the build. -->
  </ItemGroup>
</Project>

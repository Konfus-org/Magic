<!-- A gem: everything it needs to build comes from ../Directory.Build.props. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Rigid-body physics through Box3D: moves entities with a Physics component.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A generated C API is pointers and fixed buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <NativeLibrary Include="box3d" Headers="include/box3d/box3d.h;include/box3d/collision.h" IncludePath="include"
                   Prefixes="b3=B3" Class="B3" />
  </ItemGroup>
</Project>

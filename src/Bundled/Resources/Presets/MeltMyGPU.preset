{
    // Everything up: drawn at one and a half times the screen's size each way and scaled down, the finest clusters,
    // and textures filtered with every tap. Bring a fan.
    "settings": {
        "VoxelRendering.renderScale": 1.5,
        "VoxelRendering.clusterError": 0.5,
        "VoxelRendering.anisotropy": 16
    }
}

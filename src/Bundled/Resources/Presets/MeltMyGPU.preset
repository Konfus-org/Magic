{
    // Everything up: drawn at 2160p and scaled down, the finest clusters, the sharpest sun
    // shadows close up, twice the pages of shadow drawn a frame, and global illumination traced with more rays, its
    // finest probes every frame. Bring a fan.
    "settings": {
        "ClusterRendering.renderHeight": 2160,
        "ClusterRendering.clusterError": 0.5,
        "ClusterRendering.shadowFinest": 4,
        "ClusterRendering.shadowUpdates": 1024,
        "ClusterRendering.anisotropy": 16,
        "ClusterRendering.giRays": 128,
        "ClusterRendering.giUpdateEvery": 1
    }
}

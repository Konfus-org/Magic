{
    // An integrated GPU, or a GTX 1660: drawn at half the screen's size each way and scaled up, coarser clusters,
    // fewer pieces a view, and textures filtered with fewer taps.
    "settings": {
        "VoxelRendering.renderScale": 0.5,
        "VoxelRendering.clusterError": 2,
        "VoxelRendering.pieceCapacity": 524288,
        "VoxelRendering.anisotropy": 2
    }
}

{
    // An integrated GPU, or a GTX 1660: drawn at 720p and scaled up, coarser clusters, coarser sun
    // shadows in a smaller pool drawn fewer pages a frame, fewer point and spot lights lit pixel by pixel, textures
    // filtered with fewer taps, global illumination three levels deep with fewer rays traced less often, and ambient
    // occlusion searching one slice.
    "settings": {
        "PipelineLoader.params": { "Gtao": { "slices": { "x": 1 }, "steps": { "x": 3 } } },
        "ClusterRendering.renderHeight": 720,
        "ClusterRendering.clusterError": 2,
        "ClusterRendering.pieceCapacity": 524288,
        "ClusterRendering.lightCapacity": 4096,
        "ClusterRendering.shadowBudget": 64,
        "ClusterRendering.shadowFinest": 12,
        "ClusterRendering.shadowUpdates": 128,
        "ClusterRendering.anisotropy": 2,
        "ClusterRendering.giLevels": 3,
        "ClusterRendering.giRays": 32,
        "ClusterRendering.giUpdateEvery": 8
    }
}

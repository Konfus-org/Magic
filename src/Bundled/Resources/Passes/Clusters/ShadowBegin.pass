{
    "stage": "occlusion",
    "kind": "compute",
    "shader": { "id": 60040 },
    "reads": [ { "name": "SunClipmap" } ],
    "creates": [
        { "name": "ShadowArgs", "kind": "buffer", "type": "uint", "stride": 4, "rows": 18 },
        { "name": "ShadowCounts", "kind": "buffer", "type": "uint", "stride": 4, "rows": 4, "seed": "Zeros" },
        { "name": "ShadowViews", "kind": "buffer", "type": "GpuShadowView", "stride": 80, "per": "shadowViews" },
        { "name": "ShadowGroups", "kind": "buffer", "type": "GpuShadowGroup", "stride": 32, "per": "shadowGroups" },
        { "name": "ShadowJobs", "kind": "buffer", "type": "uint4", "stride": 16, "per": "jobs" },
        { "name": "ShadowPieces", "kind": "buffer", "type": "uint3", "stride": 12, "per": "pieces" },
        { "name": "ShadowCandidates", "kind": "buffer", "type": "uint", "stride": 4, "per": "shadowCandidates" },
        { "name": "ShadowLightGroups", "kind": "buffer", "type": "uint2", "stride": 8, "per": "sceneLights" }
    ],
    "writes": [ { "name": "ShadowTables" } ],
    "dispatch": { "per": "lightEntries" }
}

{
    "stage": "cull",
    "kind": "compute",
    "shader": { "id": 60020 },
    "creates": [
        { "name": "CullCounts", "kind": "buffer", "type": "uint", "stride": 4, "rows": 32, "seed": "Zeros" },
        { "name": "CullArgs", "kind": "buffer", "type": "uint3", "stride": 12, "rows": 8 },
        { "name": "Budget", "kind": "buffer", "type": "uint", "stride": 4, "rows": 128 },
        { "name": "BinCounts", "kind": "buffer", "type": "uint", "stride": 4, "per": "rasterBins", "seed": "Zeros" },
        { "name": "BinCursors", "kind": "buffer", "type": "uint", "stride": 4, "per": "rasterBins" },
        { "name": "BinArgs", "kind": "buffer", "type": "uint", "stride": 20, "rows": 512 },
        { "name": "VisibleClusters", "kind": "buffer", "type": "uint4", "stride": 16, "per": "clusters" },
        { "name": "VisiblePieces", "kind": "buffer", "type": "uint3", "stride": 12, "per": "pieces" },
        { "name": "Jobs", "kind": "buffer", "type": "uint4", "stride": 16, "per": "jobs" },
        { "name": "HiddenInstances", "kind": "buffer", "type": "uint", "stride": 4, "per": "instances" },
        { "name": "HiddenClusters", "kind": "buffer", "type": "uint2", "stride": 8, "per": "clusters" },
        { "name": "HiZ", "kind": "buffer", "type": "float", "stride": 4, "per": "hizTexels" },
        { "name": "HiZArgs", "kind": "buffer", "type": "uint3", "stride": 12, "per": "hizLevels" }
    ],
    "writes": [ { "name": "Budget" }, { "name": "HiZArgs" } ],
    "dispatch": { "groups": [ 1 ] }
}

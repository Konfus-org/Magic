<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/PrefabImporter/PrefabImporter.dll when a project lists PrefabImporter. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Reads .prefab files.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Magic.Author" Value="$(Authors)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its asset types. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

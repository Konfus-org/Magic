<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/SaveFiles/SaveFiles.dll when a project lists SaveFiles. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Writes the game's saves as files, and the save and load console commands.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its save types. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
    <!-- Built against, never copied: the gem adds commands to the System.CommandLine that Magic loaded. -->
    <PackageReference Include="System.CommandLine" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/GIRendering/GIRendering.dll when a project lists GIRendering. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Draws the world: every renderer's model as GPU-culled clusters into a visibility buffer, resolved by material and lit.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- meshoptimizer is a C API over arrays. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests drive the cluster and distance field builders directly. -->
    <InternalsVisibleTo Include="GIRendering.Tests" />
  </ItemGroup>
  <ItemGroup>
    <NativeLibrary
      Include="meshoptimizer"
      Repository="https://github.com/zeux/meshoptimizer"
      Tag="v1.3"
      CMakeOptions="-DMESHOPT_BUILD_SHARED_LIBS=ON;-DMESHOPT_INSTALL=ON"
      Headers="src/meshoptimizer.h"
      IncludePath="src"
    />
  </ItemGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

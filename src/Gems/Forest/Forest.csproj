<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/Forest/Forest.dll when a project lists Forest. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Grows a forest of a hundred thousand trees when the Forest domain opens: what the renderer draws to the horizon.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Magic.Author" Value="$(Authors)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

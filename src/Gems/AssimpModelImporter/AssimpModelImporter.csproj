<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/AssimpModelImporter/AssimpModelImporter.dll when a project lists AssimpModelImporter. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Reads FBX, glTF and OBJ model files through assimp: provides IAssetImporter&lt;Model&gt;.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- assimp is a C API: its scene is a tree of pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Magic.Author" Value="$(Authors)" />
  </ItemGroup>
  <!-- The three importers alone, with assimp's own zlib, as a shared library named plainly on every platform. The
       headers its build generates from templates are made from those templates for the bindings. Unbound are the
       macros that name an enum's members, which C# cannot make constants of. -->
  <ItemGroup>
    <NativeLibrary
      Include="assimp"
      Repository="https://github.com/assimp/assimp"
      Tag="v6.0.5"
      CMakeOptions="-DBUILD_SHARED_LIBS=ON;-DASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT=OFF;-DASSIMP_BUILD_FBX_IMPORTER=ON;
                    -DASSIMP_BUILD_GLTF_IMPORTER=ON;-DASSIMP_BUILD_OBJ_IMPORTER=ON;-DASSIMP_NO_EXPORT=ON;
                    -DASSIMP_BUILD_ALL_EXPORTERS_BY_DEFAULT=OFF;-DASSIMP_BUILD_TESTS=OFF;-DASSIMP_BUILD_ASSIMP_TOOLS=OFF;
                    -DASSIMP_BUILD_SAMPLES=OFF;-DASSIMP_BUILD_ZLIB=ON;-DASSIMP_WARNINGS_AS_ERRORS=OFF;
                    -DASSIMP_INJECT_DEBUG_POSTFIX=OFF;-DASSIMP_LIBRARY_SUFFIX=;-DASSIMP_BUILD_USE_CCACHE=OFF;
                    -DASSIMP_INSTALL=ON"
      Headers="include/assimp/cimport.h;include/assimp/scene.h;include/assimp/postprocess.h"
      IncludePath="include"
      Shims="assimp/config.h=include/assimp/config.h.in;assimp/revision.h=include/assimp/revision.h.in"
      Unbound="AI_FAILURE;AI_MATKEY_ANISOTROPY_TEXTURE;AI_MATKEY_BASE_COLOR_TEXTURE;AI_MATKEY_CLEARCOAT_NORMAL_TEXTURE;AI_MATKEY_CLEARCOAT_ROUGHNESS_TEXTURE;AI_MATKEY_CLEARCOAT_TEXTURE;AI_MATKEY_METALLIC_TEXTURE;AI_MATKEY_ROUGHNESS_TEXTURE;AI_MATKEY_SHEEN_COLOR_TEXTURE;AI_MATKEY_SHEEN_ROUGHNESS_TEXTURE;AI_MATKEY_TRANSMISSION_TEXTURE;AI_MATKEY_VOLUME_THICKNESS_TEXTURE;AI_OUTOFMEMORY;AI_SUCCESS;AI_TEXTURE_TYPE_MAX;DLS_DEBUGGER;DLS_FILE;DLS_STDERR;DLS_STDOUT;aiProcessPreset_TargetRealtime_Fast;aiProcessPreset_TargetRealtime_MaxQuality;aiProcessPreset_TargetRealtime_Quality;aiProcess_ConvertToLeftHanded"
    />
  </ItemGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/Textures/Textures.dll when a project lists Textures. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Reads PNG, JPEG, TGA and BMP image files into textures with mips, block-compressed and cached: provides IAssetImporter&lt;Texture&gt;.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Magic.Author" Value="$(Authors)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Decodes the image files, and encodes their texels into BC7 blocks. -->
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="BCnEncoder.Net" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

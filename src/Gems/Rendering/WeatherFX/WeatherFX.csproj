<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/WeatherFX/WeatherFX.dll when a project lists WeatherFX. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Draws the weather: the haze that fills the air, lit by the sky and the sun with shafts of sunlight where rays see the world, and the clouds over the sky, which the wind carries.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces, and
         the renderer a project lists beside it, whose view it fills the air of. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
    <ProjectReference Include="../DeferredRendering/DeferredRendering.csproj" Private="false" />
  </ItemGroup>
</Project>

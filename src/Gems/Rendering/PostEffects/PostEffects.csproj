<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/PostEffects/PostEffects.dll when a project lists PostEffects. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>The post effects: the exposure, the tonemap and the other effects of the world's post processing, run over each view's lit picture before the renderer shows it.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces, and
         the renderer a project lists beside it, whose view's picture it runs the effects over. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
    <ProjectReference Include="../DeferredRendering/DeferredRendering.csproj" Private="false" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/TaaUpscaling/TaaUpscaling.dll when a project lists TaaUpscaling. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Takes the finished picture from the render size to the window's size with temporal anti-aliasing: the camera jitters, and the frames' samples add up to detail finer than the picture's texels.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces, and
         the world's gem a project lists beside it, whose view it upscales. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
    <ProjectReference Include="../GpuWorld/GpuWorld.csproj" Private="false" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/TracedReflections/TracedReflections.dll when a project lists TracedReflections. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>Traces what each smooth surface reflects, on a GPU that traces rays.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces, the
         renderer a project lists beside it, whose view it reflects, and the indirect light, whose probes light what
         its rays land on. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
    <ProjectReference Include="../DeferredRendering/DeferredRendering.csproj" Private="false" />
    <ProjectReference Include="../GlobalIllumination/GlobalIllumination.csproj" Private="false" />
  </ItemGroup>
</Project>

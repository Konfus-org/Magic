<Project Sdk="Microsoft.NET.Sdk">
  <!-- A gem: Magic loads it from Gems/VulkanGraphics/VulkanGraphics.dll when a project lists VulkanGraphics. -->
  <PropertyGroup>
    <!-- Shown beside the gem as Magic starts it. -->
    <Description>The GPU through Vulkan 1.3: provides IGraphicsApi.</Description>
    <Version>1.0.0</Version>
    <Authors>Konfus</Authors>
    <!-- Copies the gem's own NuGet dependencies next to it, where its load context finds them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Vulkan is a C API: its structures hold pointers and its handles are opaque. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Magic.Author" Value="$(Authors)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The API over the system's Vulkan loader; the one native library that is a package (CODE_STANDARDS, Ground rules). -->
    <PackageReference Include="Vortice.Vulkan" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built against, never copied: the gem uses the Magic it runs in, so it shares its IGem and its interfaces. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
  </ItemGroup>
</Project>

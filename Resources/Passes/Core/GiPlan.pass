    "tuning": {
        "levels": {
            "label": "Levels",
            "description": "Nested volumes around the camera, each this much coarser than the last. Must match what the pass creates in its file: change both there.",
            "fixed": true
        },
        "resolution": {
            "label": "Voxels a side",
            "description": "Voxels along each side of a level. Must match what the pass creates in its file: change both there.",
            "fixed": true
        },
        "voxelSize": {
            "label": "Finest voxel (m)",
            "description": "Size of a voxel in the finest level.",
            "min": 0.25,
            "max": 4
        },
        "levelScale": {
            "label": "Level scale",
            "description": "How much bigger each level's voxels are than the last's.",
            "min": 2,
            "max": 8
        },
        "framesPerRebuild": {
            "label": "Frames per rebuild",
            "description": "A level is rebuilt every this many frames; the frames between rebuild nothing.",
            "min": 1,
            "max": 8
        }
    }

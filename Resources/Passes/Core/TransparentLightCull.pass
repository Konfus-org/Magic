{
    "kind": "compute",
    "shader": {
        "id": 26775931263937049
    },
    "needs": "$transparentChunks",
    "defines": [
        "#define TRANSPARENT_TILES 1"
    ],
    "creates": [
        {
            "name": "TransparentTiles",
            "kind": "buffer",
            "per": "$viewTiles",
            "stride": 4096,
            "min": 4096
        }
    ],
    "reads": [
        {
            "name": "Depth",
            "filter": "nearest"
        },
        {
            "name": "Lights"
        }
    ],
    "writes": [
        {
            "name": "TransparentTiles"
        }
    ],
    "dispatch": {
        "per": "view",
        "tile": 256
    }
}

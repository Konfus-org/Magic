<Project>

  <!-- Shared settings for every project in this repo. -->

  <PropertyGroup>
    <!-- Single source of truth for the target framework. Declared here (not
         in each csproj) so the output paths below can use it: this file is
         imported before a project's own PropertyGroup is evaluated. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- The SDK only defaults Configuration later, in its .targets. Default
         it here so it's usable in the paths below under a plain
         "dotnet build" (VS and "dotnet build -c X" pass it in explicitly). -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <!-- The three build configurations. The SDK defines the upper-cased configuration name
         for every build (Microsoft.NET.Sdk.CSharp.targets), so code gets exactly one of
         DEBUG, OPTIMIZE or RELEASE:
           Debug    - no optimisation, DEBUG.
           Optimize - optimised code with full symbols, OPTIMIZE: profile real performance
                      while still being able to step through it.
           Release  - optimised code, RELEASE. -->
    <Configurations>Debug;Optimize;Release</Configurations>

    <!-- Repo root, for project references that must not depend on where a project lives. -->
    <MagicRoot>$(MSBuildThisFileDirectory)</MagicRoot>

    <!-- The machine doing the build, as a portable runtime (linux-x64): an SDK from a Linux distribution calls
         itself by the distribution (ubuntu.26.04-x64), which no native package is published for. -->
    <MagicHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</MagicHostOS>
    <MagicHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</MagicHostOS>
    <MagicHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</MagicHostOS>
    <MagicHostRuntime>$(MagicHostOS)-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</MagicHostRuntime>

    <!-- The platform being built for: the machine's own unless "-r <rid>" says otherwise. No csproj names a
         runtime; the projects that carry native libraries (gems, tests) build for this one. -->
    <MagicRuntime>$(RuntimeIdentifier)</MagicRuntime>
    <MagicRuntime Condition="'$(MagicRuntime)' == ''">$(MagicHostRuntime)</MagicRuntime>

    <!-- The same, as native packages that ship one per OS spell it: "SDL3-CS.$(MagicPlatform)". -->
    <MagicPlatform Condition="$(MagicRuntime.StartsWith('win'))">Windows</MagicPlatform>
    <MagicPlatform Condition="$(MagicRuntime.StartsWith('linux'))">Linux</MagicPlatform>
    <MagicPlatform Condition="$(MagicRuntime.StartsWith('osx'))">MacOS</MagicPlatform>

    <!-- A build for another platform ("-r linux-x64" on Windows) gets a folder of its own, so it never
         overwrites the machine's own build: Build\net10.0\Debug-linux-x64\. -->
    <MagicBuildDir>$(MSBuildThisFileDirectory)Build\$(TargetFramework)\$(Configuration)\</MagicBuildDir>
    <MagicBuildDir Condition="'$(MagicRuntime)' != '$(MagicHostRuntime)'">$(MSBuildThisFileDirectory)Build\$(TargetFramework)\$(Configuration)-$(MagicRuntime)\</MagicBuildDir>

    <!-- The runtime is in the path already when it matters; the SDK must not add a folder for it. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Stop the SDK from appending net10.0\ after the path; it's already in it. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <OutputPath>$(MagicBuildDir)bin\</OutputPath>
    <!-- BaseIntermediateOutputPath is where NuGet restore writes
         project.assets.json; IntermediateOutputPath is where the compiler
         writes. Pointing both at the same folder keeps everything in one obj\. -->
    <BaseIntermediateOutputPath>$(MagicBuildDir)obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>

    <!-- Reference assemblies only speed up incremental builds across
         projects; skipping them keeps a ref\ folder out of obj\. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- The SDK only excludes bin\ and obj\ from the *.cs glob by way of
         the two paths above, which now live under Build\. Exclude the
         conventional folders by name too, so a stale obj\ left next to a
         csproj can never get compiled as source. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The SDK only knows Debug and Release: it sets Optimize and DebugSymbols from those
       names, so Optimize has to set them itself. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Optimize'">
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- A gem is any project that sets <IsMagicGem>true</IsMagicGem> *before* importing Sdk.props
       (see Gems\SDL\SDL.csproj). A property set in the body of a csproj that uses the Sdk="..."
       attribute is not visible here: this file is imported by the SDK before that body is read.
       Not tied to the Gems\ folder, so a project created from the template elsewhere still builds as a gem. -->
  <PropertyGroup Condition="'$(IsMagicGem)' == 'true'">
    <!-- Gems are plugins: build as class libraries only, never an EXE/apphost. -->
    <OutputType>Library</OutputType>

    <!-- Marks this as a dynamically-loaded plugin, so the SDK writes a
         .deps.json and copies its dependencies locally. A gem loaded
         via reflection outside the host's own dependency graph needs
         those sitting right next to it. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- A runtime makes the SDK copy a package's native libraries for that platform, and only those, flat next
         to the gem, where its load context finds them. -->
    <RuntimeIdentifier>$(MagicRuntime)</RuntimeIdentifier>

    <!-- Gems aren't published to NuGet. -->
    <IsPackable>false</IsPackable>

    <!-- All gems land flat in bin\Gems\ next to the host exe: that is the
         folder the host's gem loader (Magic\Gems.cs) scans for plugin DLLs at runtime. -->
    <OutputPath>$(MagicBuildDir)bin\Gems\</OutputPath>

    <!-- Intermediate files get one folder per gem. Sharing a single obj\
         between projects breaks MSBuild's incremental build (they overwrite
         each other's per-project caches). -->
    <BaseIntermediateOutputPath>$(MagicBuildDir)obj\Gems\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
  </PropertyGroup>

  <!-- What the host needs to know about a gem before it constructs it, stamped into the assembly. Set in the gem's
       csproj: GemStatic (true: loaded once, never reloaded) and GemDependsOn (gem names, ';' separated, that must be
       loaded first though no service connects them). The gem's name is its assembly name; Version, Description and
       Authors are the SDK's own properties. Items are evaluated after every property, so the csproj body's values count. -->
  <ItemGroup Condition="'$(IsMagicGem)' == 'true'">
    <AssemblyMetadata Include="MagicGem.Static" Value="$(GemStatic)" />
    <AssemblyMetadata Include="MagicGem.DependsOn" Value="$(GemDependsOn)" />
  </ItemGroup>

</Project>

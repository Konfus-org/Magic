<Project>
  <!-- Every project. The build is strict: every compiler, analyzer, MSBuild and NuGet warning is an error, but code in
       flight's: an unused member, value, parameter, field or class, and unreachable code, stay warnings. The analyzer
       rules are in .editorconfig, and the house rules are tools/Analyzers. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Configurations>Debug;Optimize;Release</Configurations>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!-- On the compiler's list and on MSBuild's, which promotes the compiler's warnings too. -->
    <WarningsNotAsErrors>IDE0051;IDE0052;IDE0059;IDE0060;IDE0035;CA1812;CA1823;CS0168;CS0219;CS8321;CS0162</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>IDE0051;IDE0052;IDE0059;IDE0060;IDE0035;CA1812;CA1823;CS0168;CS0219;CS8321;CS0162</MSBuildWarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Also what lets the build report unused usings (IDE0005). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A package with a high or critical vulnerability, direct or transitive, fails the restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <!-- CSharpier decides layout (.editorconfig's [*] block): the editor's extension formats a file on save, and a local
         build formats what is left. tools/Scripts/Validate.ps1, which CI runs, checks instead and refuses a file
         CSharpier would change. -->
    <CSharpier_Check>false</CSharpier_Check>
    <CSharpier_LogLevel>Warning</CSharpier_LogLevel>
  </PropertyGroup>

  <!-- Output. Build/bin/<Configuration>/ is Magic's folder, and where it loads the rest from: the gems in src/Gems/
       from Gems/<Name>/, the assets in src/Resources/ from Resources/, a project's code from Projects/<Name>/; tests and the build's
       tools, which never ship, go under Tests/<Name>/ and Tools/<Name>/. A project is placed by where its source is,
       here rather than in its own folder, because MSBuild fixes the intermediate folder before any project file or
       nearer Directory.Build.props is read. A project's intermediate files are its own, in
       Build/obj/<Configuration>/<Name>/, so projects that share an output folder never share them. MagicRoot is the
       repository's root, for a path that must hold wherever a project sits, as a template's does. -->
  <PropertyGroup>
    <MagicRoot>$(MSBuildThisFileDirectory)</MagicRoot>
    <MagicSource>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</MagicSource>
    <MagicOutput Condition="$(MagicSource.StartsWith('src/Gems/'))">Gems/$(MSBuildProjectName)/</MagicOutput>
    <MagicOutput Condition="$(MagicSource.StartsWith('src/Resources/'))">Resources/</MagicOutput>
    <MagicOutput Condition="$(MagicSource.StartsWith('samples/'))">Projects/$(MSBuildProjectName)/</MagicOutput>
    <MagicOutput Condition="$(MagicSource.StartsWith('tests/'))">Tests/$(MSBuildProjectName)/</MagicOutput>
    <MagicOutput Condition="$(MagicSource.StartsWith('tools/'))">Tools/$(MSBuildProjectName)/</MagicOutput>
    <MagicBin>$(MSBuildThisFileDirectory)Build/bin/$(Configuration)/</MagicBin>
    <OutputPath>$(MagicBin)$(MagicOutput)</OutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)Build/obj/$(Configuration)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Assets: a part's own are its Resources/ folder (MagicResources). A release copies them beside its assembly, their
       READMEs and any project file left behind; any other build copies nothing and records the folder in the assembly
       (Magic.Resources), so assets are read where they are written, and an edit reaches a running engine without a
       build. -->
  <PropertyGroup>
    <MagicResources>$(MSBuildProjectDirectory)/Resources</MagicResources>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content
      Include="$(MagicResources)/**"
      Exclude="$(MagicResources)/**/*.md;$(MagicResources)/**/*.csproj"
      LinkBase="Resources"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <AssemblyMetadata Include="Magic.Resources" Value="$([System.IO.Path]::GetFullPath('$(MagicResources)'))" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Integer overflow throws while developing instead of wrapping silently; wrap on purpose with unchecked. -->
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Optimize'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <!-- Source paths compiled in, such as the file each log line names, start at the repository rather than the
         folders of the machine that built it. Other configurations keep full paths, so debuggers find the sources. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <!-- Global usings, listed rather than implied. No System.Linq (no LINQ in the frame loop) and no System.IO (disk
       access goes through IFileSystem): a file that needs either says so. -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
  </ItemGroup>

  <!-- The house rules (tools/Analyzers) run in every other project, as an analyzer rather than a reference. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Magic.Analyzers'">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)tools/Analyzers/Magic.Analyzers/Magic.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>

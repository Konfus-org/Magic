{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git branch -D *)",
      "Bash(git commit --no-verify*)",
      "Bash(git merge --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/statusline.ps1\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionStart.ps1\"",
            "timeout": 30,
            "statusMessage": "Reading PLAN.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-checkout.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "shell": "bash",
            "command": "input=$(cat); case \"$input\" in *commit*|*merge*) printf '%s' \"$input\" | powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/tools/Scripts/AgentTaskComplete.ps1\" -Hook || exit 2; printf '%s' \"$input\" | powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/ReviewGuard.ps1\" ;; esac",
            "timeout": 120,
            "statusMessage": "Checking the slice was validated and reviewed"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "slice-reviewer",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/RecordReview.ps1\"",
            "timeout": 60,
            "statusMessage": "Recording the slice review"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "plannotator",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}

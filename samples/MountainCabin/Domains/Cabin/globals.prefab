                {"name": "Wall +X", "components": {"Transform": {"position": {"x": 1.25, "y": 0, "z": 0}, "scale": {"x": 0.25, "y": 1.25, "z": 1.5}}, "Renderer": {"model": {"id": 514}, "materials": [{"id": 300061}]}}},
                {"name": "Wall -Z", "components": {"Transform": {"position": {"x": 0, "y": 0, "z": -1.25}, "scale": {"x": 1.5, "y": 1.25, "z": 0.25}}, "Renderer": {"model": {"id": 514}, "materials": [{"id": 300061}]}}},

    "entities": [
        {"name": "Spawn", "tags": ["spawn"], "components": {"Transform": {"position": {"x": -3074.1, "y": 1151.45, "z": -217.2}, "rotation": {"x": 0, "y": -0.5373, "z": 0, "w": 0.84339}}}},

        {"name": "ReferenceView.LeakRoom", "tags": ["render-reference"], "components": {"Transform": {"position": {"x": -3069.870, "y": 1150.540, "z": -208.990}, "rotation": {"x": -0.173648, "y": 0.000000, "z": 0.000000, "w": 0.984808}}}},
        // The look: the sky gives 1.6 times the light of the air itself, which lifts the shadows and the room, and
        // the sun and the moon keep their own light.
        {"name": "Sky", "tags": ["sky"], "components": {"Sky": {"material": {"id": 4569236087865836549}, "brightness": 1.6}}},
        // The sun faces west along the door wall, so at noon it stands south, on the door wall's normal, the cabin's -Z:
        // through the middle of the day it shines into the room through the doorway and the door wall's window, and the
        // open door panel, which stands out from that wall, throws a shadow on the wall and the doorstep.
        {"name": "Sun", "tags": ["sun"], "components": {"Transform": {"rotation": {"x": 0, "y": 0.9763, "z": 0, "w": -0.21644}}, "DirectionalLight": {"mode": "sun", "color": {"r": 1, "g": 0.96, "b": 0.9}, "intensity": 120000}, "ScriptContainer": [{"id": 100421, "hour": 15, "hoursPerMinute": 1}]}},
        // The full moon goes the sun's path 12 hours behind it, so it stands opposite the sun and is up while the sun is
        // down. Its hour and its speed keep it there: a change to the sun's needs the same change here.
        {"name": "Moon", "tags": ["moon"], "components": {"Transform": {"rotation": {"x": 0, "y": 0.9763, "z": 0, "w": -0.21644}}, "DirectionalLight": {"mode": "moon", "color": {"r": 0.75, "g": 0.85, "b": 1}, "intensity": 0.3}, "ScriptContainer": [{"id": 100421, "hour": 3, "hoursPerMinute": 1}]}},
        {"name": "Terrain", "components": {"Transform": {}, "Renderer": {"model": {"id": 300001}, "materials": [{"id": 300011}]}}},
        // A sealed room 10 m behind the cabin, in the clearing: a shell of the cabin's own logs, floorboards and
        // slates, 0.5 m thick, around a space of 2 m on each axis, with no opening and no light in it. Every part
        // runs past the next one, so no two faces meet on a line. Its floor stands clear of the ground, which
        // slopes, and its slab reaches 0.9 m down into it. The leak-room view stands in it: what it sees
        // must be black, and any light in it is a leak.
        {"name": "Leak room", "components": {"Transform": {"position": {"x": -3069.87, "y": 1151.39, "z": -208.14}}},
            "children": [
                {"name": "Floor", "components": {"Transform": {"position": {"x": 0, "y": -1.45, "z": 0}, "scale": {"x": 1.5, "y": 0.45, "z": 1.5}}, "Renderer": {"model": {"id": 514}, "materials": [{"id": 300062}]}}},

<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- A project's own code: the scripts and the components they use, the .cs files under its Assets/, compiled by the
       csproj beside its .magic file, named like the project, into Projects/<Name>/ beside Magic (the root
       Directory.Build.props places it there), which loads it with the project. It is no gem: Magic only takes in its
       types. -->
  <PropertyGroup>
    <RootNamespace>Magic.$(MSBuildProjectName)</RootNamespace>
    <!-- Copies the project's own NuGet dependencies, native ones included, next to it. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against, never copied: at run time the project's code uses the Magic that loaded it. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Core/Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Its Run, an IDE's or dotnet run's: Magic opening the project, started in the repository. A run needs what Magic
       loads with the project built too, the bundled gems and resources, which the project's code never compiles
       against: they are built before it, each only where it changed, and nothing of them is referenced or copied, so
       no target framework is negotiated with them either, which would load each of them once more for nothing. -->
  <PropertyGroup>
    <RunCommand>$(MagicBin)Magic</RunCommand>
    <RunCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MagicBin)Magic.exe</RunCommand>
    <RunArguments>--project "$(MSBuildProjectDirectory)"</RunArguments>
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)../</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Bundled/Gems/*/*.csproj;$(MSBuildThisFileDirectory)../src/Bundled/Resources/Resources.csproj"
                      ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>

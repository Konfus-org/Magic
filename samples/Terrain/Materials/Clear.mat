// Glass at full clarity: it lets all the light behind it through, so what it draws keeps only a pane's sheen. The
// cabin's door and window slots take it.
{
    "shader": { "id": 10004 },
    "params": {
        "color": { "r": 1, "g": 1, "b": 1, "a": 1 },
        "clarity": { "x": 1 },
        "roughness": { "x": 1 }
    }
}

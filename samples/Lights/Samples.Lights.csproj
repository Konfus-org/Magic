<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sample's own code, beside its .magic file. Its Run is Magic opening the sample headless. -->
  <PropertyGroup>
    <RunCommand>$(MagicBin)Magic</RunCommand>
    <RunCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MagicBin)Magic.exe</RunCommand>
    <RunArguments>open "$(MSBuildProjectDirectory)/Lights.magic" --headless true</RunArguments>
    <RunWorkingDirectory>$(MagicRoot)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built before the sample so its Run has a Magic, and the gems it lists, to start; nothing of them is referenced
         or copied. -->
    <ProjectReference
      Include="$(MagicRoot)src/Core/Magic.Core.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/SdlPlatform/SdlPlatform.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/VulkanGraphics/VulkanGraphics.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/SlangShaders/SlangShaders.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/ArchEcs/ArchEcs.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/AssimpModels/AssimpModels.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/MeshPreprocessor/MeshPreprocessor.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Textures/Textures.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/WorldRenderer/WorldRenderer.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/PrefabImporter/PrefabImporter.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/DomainImporter/DomainImporter.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
</Project>

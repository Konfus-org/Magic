<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sample's own code, beside its .magic file, which Magic loads with it. Its Run is Magic opening the sample headless. -->
  <PropertyGroup>
    <RunCommand>$(MagicBin)Magic</RunCommand>
    <RunCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MagicBin)Magic.exe</RunCommand>
    <RunArguments>open "$(MSBuildProjectDirectory)/Lights.magic" --headless true</RunArguments>
    <RunWorkingDirectory>$(MagicRoot)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built before the sample so its Run has a Magic, and the gems it lists, to start. Its code is built against Magic
         and the scripting gem, and nothing of them is copied. -->
    <ProjectReference Include="$(MagicRoot)src/Core/Magic.Core.csproj" Private="false" />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/SdlPlatform/SdlPlatform.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/VulkanGraphics/VulkanGraphics.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/SlangShaderCompiler/SlangShaderCompiler.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/ArchEcs/ArchEcs.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/AssimpModelImporter/AssimpModelImporter.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/SdlTextureImporter/SdlTextureImporter.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/ImGuiDebugUI/ImGuiDebugUI.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/DebugTools/DebugTools.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Rendering/ClusteredGeometry/ClusteredGeometry.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Rendering/AccelerationStructures/AccelerationStructures.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Rendering/TracedShadows/TracedShadows.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Rendering/DeferredRendering/DeferredRendering.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Rendering/GlobalIllumination/GlobalIllumination.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Rendering/Volumetrics/Volumetrics.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/PrefabImporter/PrefabImporter.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/DomainImporter/DomainImporter.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference Include="$(MagicRoot)src/Gems/CSharpScripting/CSharpScripting.csproj" Private="false" />
    <ProjectReference
      Include="$(MagicRoot)samples/Shared/SamplesShared.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
</Project>

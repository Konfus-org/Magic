<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sample's own code, beside its .magic file. Its Run is Magic opening the sample headless. -->
  <PropertyGroup>
    <RunCommand>$(MagicBin)Magic</RunCommand>
    <RunCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MagicBin)Magic.exe</RunCommand>
    <RunArguments>open "$(MSBuildProjectDirectory)/HelloWorld.magic" --headless true</RunArguments>
    <RunWorkingDirectory>$(MagicRoot)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built before the sample so its Run has a Magic, and the gems it lists, to start; nothing of them is referenced
         or copied. -->
    <ProjectReference
      Include="$(MagicRoot)src/Core/Launcher/Magic.Launcher.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
    <ProjectReference
      Include="$(MagicRoot)src/Gems/Hello/Hello.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
</Project>

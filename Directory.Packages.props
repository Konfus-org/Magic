<Project>
  <!-- Every NuGet version lives here; a project names the package only. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Arch" Version="2.1.0" />
    <PackageVersion Include="AssimpNetter" Version="6.0.5" />
    <PackageVersion Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageVersion Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageVersion Include="ppy.SDL3_image-CS" Version="2026.1002.1" />
    <PackageVersion Include="ppy.SDL3_ttf-CS" Version="2026.1002.1" />
    <PackageVersion Include="SDL3-CS.Linux.Shadercross" Version="3.0.0.13" />
    <PackageVersion Include="SDL3-CS.MacOS.Shadercross" Version="3.0.0.13" />
    <PackageVersion Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.13" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

  <!-- Analyzers every project runs; their rules are configured in .editorconfig. -->
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.294" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891" />
  </ItemGroup>
</Project>

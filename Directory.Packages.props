<Project>
  <!-- Every NuGet version lives here; a project names the package only. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Arch" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <PackageVersion Include="Vortice.Vulkan" Version="3.3.0" />
  </ItemGroup>

  <!-- Microsoft's bindings generator: a native tool per runtime, which a project declaring a native library downloads
       and runs (Directory.Build.targets) rather than references, so its version is a property. -->
  <PropertyGroup>
    <ClangSharpPInvokeGeneratorVersion>21.1.8.4</ClangSharpPInvokeGeneratorVersion>
  </PropertyGroup>

  <!-- Tests (tests/README.md). -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- The compiler and workspace the repository's own analyzers build against (tools/Analyzers): no newer than the ones
       the SDK in global.json and Visual Studio run, or neither could load them. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <!-- Analyzers every project runs; their rules are configured in .editorconfig. -->
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.294" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.149-beta" />
  </ItemGroup>
</Project>

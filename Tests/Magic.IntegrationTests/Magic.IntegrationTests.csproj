<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests: real files, the asset watcher, native loaders and gem DLLs. See Tests\README.md. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Magic.IntegrationTests</RootNamespace>
    <RuntimeIdentifier>$(MagicRuntime)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- One fake renderer and one fake window for both suites. -->
    <Compile Include="..\Magic.UnitTests\Fakes\FakeRendering.cs" Link="Fakes\FakeRendering.cs" />
    <Compile Include="..\Magic.UnitTests\Fakes\FakeWindows.cs" Link="Fakes\FakeWindows.cs" />
    <Compile Include="..\Magic.UnitTests\Fakes\LoadedTypes.cs" Link="Fakes\LoadedTypes.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Magic\Magic.csproj" />
    <!-- The gems are constructed in-process, no gem loader involved; the package natives (SDL3.dll,
         SDL3_image.dll, SDL3_ttf.dll, assimp.dll) land flat next to the tests because of the RuntimeIdentifier. -->
    <ProjectReference Include="..\..\Gems\FlecsEcs\FlecsEcs.csproj" />
    <ProjectReference Include="..\..\Gems\SDL\SDL.csproj" />
    <ProjectReference Include="..\..\Gems\SDLImage\SDLImage.csproj" />
    <ProjectReference Include="..\..\Gems\SDLInput\SDLInput.csproj" />
    <ProjectReference Include="..\..\Gems\SDLFonts\SDLFonts.csproj" />
    <ProjectReference Include="..\..\Gems\AssimpModels\AssimpModels.csproj" />
    <!-- Built, not referenced: the loader tests find it in bin\Tests\Gems\ as the host would. -->
    <ProjectReference Include="..\TestGem\TestGem.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestScripts\TestScripts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Gems\CSharpScripting\CSharpScripts.csproj" />
    <ProjectReference Include="..\..\Gems\Streaming\WorldStreaming.csproj" />
    <ProjectReference Include="..\..\Gems\Scripting\Scripting.csproj" />
    <ProjectReference Include="..\..\Gems\DefaultTagging\DefaultTagging.csproj" />
    <ProjectReference Include="..\..\Gems\WorldTransforms\WorldTransforms.csproj" />
    <ProjectReference Include="..\..\Gems\DeferredRenderer\DeferredRenderer.csproj" />
    <ProjectReference Include="..\..\Gems\DebugTools\DebugTools.csproj" />
  </ItemGroup>

</Project>

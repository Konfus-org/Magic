<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests: in-memory, no file system, no native loaders. See Tests\README.md. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Magic.UnitTests</RootNamespace>
    <RuntimeIdentifier>$(MagicRuntime)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- A normal reference: Magic.dll is copied next to the tests, unlike in a gem. -->
    <ProjectReference Include="..\..\Core\Magic.csproj" />
  </ItemGroup>

</Project>
